local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

if getgenv().Xvlamer_VClipActive == nil then
    getgenv().Xvlamer_VClipActive = false
end

local function cleanupVClip()
    if getgenv().Xvlamer_VClipConn then
        getgenv().Xvlamer_VClipConn:Disconnect()
        getgenv().Xvlamer_VClipConn = nil
    end
    if getgenv().Xvlamer_SpeedConn then
        getgenv().Xvlamer_SpeedConn:Disconnect()
        getgenv().Xvlamer_SpeedConn = nil
    end
    
    local char = LocalPlayer.Character
    if char then
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = true
            end
        end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = getgenv().Xvlamer_SavedSpeed or 16
            if getgenv().Xvlamer_SavedSlope ~= nil then
                humanoid.MaxSlopeAngle = getgenv().Xvlamer_SavedSlope
            end
        end
    end
    getgenv().Xvlamer_SavedSpeed = nil
    getgenv().Xvlamer_SavedSlope = nil
end

local function setVClip(state)
    if state == nil then
        getgenv().Xvlamer_VClipActive = not getgenv().Xvlamer_VClipActive
    else
        getgenv().Xvlamer_VClipActive = state and true or false
    end

    -- Sync with Main Hub saved state and UI toggle if available
    if getgenv().XvlamerHub_SavedState then
        getgenv().XvlamerHub_SavedState.Noclip = getgenv().Xvlamer_VClipActive
        pcall(function()
            local writefile = writefile or function() end
            local Http = game:GetService("HttpService")
            writefile("XvlamersSaveState.json", Http:JSONEncode(getgenv().XvlamerHub_SavedState))
        end)
    end

    if getgenv().Xvlamer_UpdateToggleState then
        pcall(function()
            getgenv().Xvlamer_UpdateToggleState("Noclip", getgenv().Xvlamer_VClipActive)
        end)
    end

    -- Always clear old connections first
    if getgenv().Xvlamer_VClipConn then
        getgenv().Xvlamer_VClipConn:Disconnect()
        getgenv().Xvlamer_VClipConn = nil
    end
    if getgenv().Xvlamer_SpeedConn then
        getgenv().Xvlamer_SpeedConn:Disconnect()
        getgenv().Xvlamer_SpeedConn = nil
    end

    if not getgenv().Xvlamer_VClipActive then
        cleanupVClip()
        return
    end

    -- Bruteforce WalkSpeed and strictly prevent stepping up / upward velocity
    getgenv().Xvlamer_SpeedConn = RunService.Heartbeat:Connect(function()
        local currentCharacter = LocalPlayer.Character
        if not currentCharacter then return end
        
        local hum = currentCharacter:FindFirstChildOfClass("Humanoid")
        if hum then
            if getgenv().Xvlamer_SavedSpeed == nil or getgenv().Xvlamer_SavedSpeed == 1.5 then
                getgenv().Xvlamer_SavedSpeed = 16
            end
            if getgenv().Xvlamer_SavedSlope == nil or getgenv().Xvlamer_SavedSlope == 0 then
                getgenv().Xvlamer_SavedSlope = hum.MaxSlopeAngle
            end
            
            if hum.WalkSpeed ~= 1.5 then
                hum.WalkSpeed = 1.5
            end
            if hum.MaxSlopeAngle ~= 0 then
                hum.MaxSlopeAngle = 0
            end
        end

        local rootPart = currentCharacter:FindFirstChild("HumanoidRootPart")
        if rootPart then
            local vel = rootPart.AssemblyLinearVelocity
            if vel.Y > 0 then
                rootPart.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
            end
        end
    end)

    -- Stable noclip loop
    getgenv().Xvlamer_VClipConn = RunService.Stepped:Connect(function()
        local currentCharacter = LocalPlayer.Character
        if not currentCharacter then return end

        for _, v in ipairs(currentCharacter:GetDescendants()) do
            if v:IsA("BasePart") and v.CanCollide then
                v.CanCollide = false
            end
        end
    end)
end

getgenv().Xvlamer_SetVClip = setVClip

-- Handle character respawns cleanly
if getgenv().Xvlamer_RespawnConn then
    getgenv().Xvlamer_RespawnConn:Disconnect()
    getgenv().Xvlamer_RespawnConn = nil
end

getgenv().Xvlamer_RespawnConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
    if getgenv().Xvlamer_VClipActive then
        task.wait(0.3)
    else
        cleanupVClip()
    end
end)

if getgenv().Xvlamer_KeyConn then
    getgenv().Xvlamer_KeyConn:Disconnect()
    getgenv().Xvlamer_KeyConn = nil
end

getgenv().Xvlamer_KeyConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.V then
        if not (UserInputService:GetFocusedTextBox()) then
            setVClip(not getgenv().Xvlamer_VClipActive)
        end
    end
end)

-- Immediately enable noclip upon loading via the Hub toggle
setVClip(true)

return setVClip
