local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

if getgenv().Xvlamer_VClipActive == nil then
    getgenv().Xvlamer_VClipActive = false
end

local function cleanupConnections()
    if getgenv().Xvlamer_VClipConn then
        getgenv().Xvlamer_VClipConn:Disconnect()
        getgenv().Xvlamer_VClipConn = nil
    end
    if getgenv().Xvlamer_HeartbeatConn then
        getgenv().Xvlamer_HeartbeatConn:Disconnect()
        getgenv().Xvlamer_HeartbeatConn = nil
    end
    if getgenv().Xvlamer_SteppedConn then
        getgenv().Xvlamer_SteppedConn:Disconnect()
        getgenv().Xvlamer_SteppedConn = nil
    end
end

-- Function to neutralize local anti-cheat detection boxes or zones in the workspace
local function sweepAntiCheatZones()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local nameLower = obj.Name:lower()
            if nameLower:find("anticheat") or nameLower:find("detect") or nameLower:find("zone") or nameLower:find("region") or nameLower:find("ban") then
                obj.CanTouch = false
                obj.CanCollide = false
            end
        end
    end
end

local function setVClip(state)
    if state == nil then
        getgenv().Xvlamer_VClipActive = not getgenv().Xvlamer_VClipActive
    else
        getgenv().Xvlamer_VClipActive = state and true or false
    end

    local char = LocalPlayer.Character
    if not char then
        if getgenv().Xvlamer_VClipActive and state == nil then
            getgenv().Xvlamer_VClipActive = false
        end
        return
    end

    local humanoid = char:FindFirstChildOfClass("Humanoid")

    if not getgenv().Xvlamer_VClipActive then
        cleanupConnections()

        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = true
            end
        end

        if humanoid then
            humanoid.WalkSpeed = getgenv().Xvlamer_SavedSpeed or 16
            humanoid.PlatformStand = false
        end
        getgenv().Xvlamer_SavedSpeed = nil
        return
    end

    if humanoid and getgenv().Xvlamer_SavedSpeed == nil then
        getgenv().Xvlamer_SavedSpeed = humanoid.WalkSpeed
    end

    cleanupConnections()
    sweepAntiCheatZones()

    if humanoid then
        humanoid.WalkSpeed = 1.5
    end

    local function lockDown(dt)
        local currentCharacter = LocalPlayer.Character
        if not currentCharacter then return end

        local currentHumanoid = currentCharacter:FindFirstChildOfClass("Humanoid")
        local rootPart = currentCharacter:FindFirstChild("HumanoidRootPart")

        if currentHumanoid then
            if currentHumanoid.WalkSpeed ~= 1.5 then
                currentHumanoid.WalkSpeed = 1.5
            end
            pcall(function()
                currentHumanoid:ChangeState(Enum.HumanoidStateType.Running)
            end)
        end

        if rootPart then
            -- Micro-stepping movement replication so the server accepts the position for interactions
            local moveDir = currentHumanoid and currentHumanoid.MoveDirection or Vector3.zero
            if moveDir.Magnitude > 0 then
                local targetCF = rootPart.CFrame + (moveDir * 1.5 * dt * 60)
                rootPart.CFrame = targetCF
            end

            -- Neutralize fall velocity spikes that cause server-side position rollbacks
            local vel = rootPart.AssemblyLinearVelocity
            rootPart.AssemblyLinearVelocity = Vector3.new(vel.X, math.clamp(vel.Y, -10, 5), vel.Z)
        end

        for _, v in ipairs(currentCharacter:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = false
            end
        end
    end

    getgenv().Xvlamer_VClipConn = RunService.RenderStepped:Connect(lockDown)
    getgenv().Xvlamer_SteppedConn = RunService.Stepped:Connect(lockDown)
    getgenv().Xvlamer_HeartbeatConn = RunService.Heartbeat:Connect(lockDown)
end

getgenv().Xvlamer_SetVClip = setVClip

if getgenv().Xvlamer_KeyConn then
    getgenv().Xvlamer_KeyConn:Disconnect()
    getgenv().Xvlamer_KeyConn = nil
end

getgenv().Xvlamer_KeyConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.V then
        if not (UserInputService:GetFocusedTextBox()) then
            setVClip(not getgenv().Xvlamer_VClipActive)
        end
    end
end)

return setVClip
