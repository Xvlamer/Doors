local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

if getgenv().Xvlamer_VClipActive == nil then
    getgenv().Xvlamer_VClipActive = false
end

local function setVClip(state)
    if state == nil then
        getgenv().Xvlamer_VClipActive = not getgenv().Xvlamer_VClipActive
    else
        getgenv().Xvlamer_VClipActive = state and true or false
    end

    local char = LocalPlayer.Character
    if not char then
        if getgenv().Xvlamer_VClipActive and state == nil then
            getgenv().Xvlamer_VClipActive = false
        end
        return
    end

    local humanoid = char:FindFirstChildOfClass("Humanoid")

    if not getgenv().Xvlamer_VClipActive then
        if getgenv().Xvlamer_VClipConn then
            getgenv().Xvlamer_VClipConn:Disconnect()
            getgenv().Xvlamer_VClipConn = nil
        end
        if getgenv().Xvlamer_SpeedConn then
            getgenv().Xvlamer_SpeedConn:Disconnect()
            getgenv().Xvlamer_SpeedConn = nil
        end

        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = true
            end
        end

        if humanoid then
            humanoid.WalkSpeed = getgenv().Xvlamer_SavedSpeed or 16
        end
        getgenv().Xvlamer_SavedSpeed = nil
        return
    end

    if humanoid and getgenv().Xvlamer_SavedSpeed == nil then
        getgenv().Xvlamer_SavedSpeed = humanoid.WalkSpeed
    end

    if getgenv().Xvlamer_VClipConn then
        getgenv().Xvlamer_VClipConn:Disconnect()
        getgenv().Xvlamer_VClipConn = nil
    end
    if getgenv().Xvlamer_SpeedConn then
        getgenv().Xvlamer_SpeedConn:Disconnect()
        getgenv().Xvlamer_SpeedConn = nil
    end

    if humanoid then
        humanoid.WalkSpeed = 1.5
        getgenv().Xvlamer_SpeedConn = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            if getgenv().Xvlamer_VClipActive and humanoid.WalkSpeed ~= 1.5 then
                humanoid.WalkSpeed = 1.5
            end
        end)
    end

    getgenv().Xvlamer_VClipConn = RunService.RenderStepped:Connect(function()
        local currentCharacter = LocalPlayer.Character
        if not currentCharacter then return end

        local currentHumanoid = currentCharacter:FindFirstChildOfClass("Humanoid")
        local rootPart = currentCharacter:FindFirstChild("HumanoidRootPart")

        if currentHumanoid then
            if currentHumanoid.WalkSpeed ~= 1.5 then
                currentHumanoid.WalkSpeed = 1.5
            end
            -- Force the state to Running so the anticheat believes you are solidly on the ground
            pcall(function()
                currentHumanoid:ChangeState(Enum.HumanoidStateType.Running)
            end)
        end

        if rootPart then
            -- Stabilize vertical velocity to prevent fall-distance/airtime flags and rubberbanding
            local vel = rootPart.AssemblyLinearVelocity
            rootPart.AssemblyLinearVelocity = Vector3.new(vel.X, math.clamp(vel.Y, -15, 5), vel.Z)
        end

        -- Completely disable collision on everything so multi-part walls never trigger physics step-up pushes
        for _, v in ipairs(currentCharacter:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = false
            end
        end
    end)
end

getgenv().Xvlamer_SetVClip = setVClip

if getgenv().Xvlamer_KeyConn then
    getgenv().Xvlamer_KeyConn:Disconnect()
    getgenv().Xvlamer_KeyConn = nil
end

getgenv().Xvlamer_KeyConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.V then
        if not (UserInputService:GetFocusedTextBox()) then
            setVClip(not getgenv().Xvlamer_VClipActive)
        end
    end
end)

return setVClip
