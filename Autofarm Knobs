local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

if getgenv().Xvlamer_KnobFarmActive == nil then
    getgenv().Xvlamer_KnobFarmActive = false
end

local function setKnobFarm(state)
    if state == nil then
        getgenv().Xvlamer_KnobFarmActive = not getgenv().Xvlamer_KnobFarmActive
    else
        getgenv().Xvlamer_KnobFarmActive = state and true or false
    end

    if getgenv().XvlamerHub_SavedState then
        getgenv().XvlamerHub_SavedState.KnobFarm = getgenv().Xvlamer_KnobFarmActive
        pcall(function()
            local writefile = writefile or function() end
            local Http = game:GetService("HttpService")
            writefile("XvlamersSaveState.json", Http:JSONEncode(getgenv().XvlamerHub_SavedState))
        end)
    end

    if getgenv().Xvlamer_UpdateToggleState then
        pcall(function()
            getgenv().Xvlamer_UpdateToggleState("KnobFarm", getgenv().Xvlamer_KnobFarmActive)
        end)
    end

    if getgenv().Xvlamer_KnobFarmThread then
        getgenv().Xvlamer_KnobFarmActive = false
        task.wait(0.1)
        getgenv().Xvlamer_KnobFarmActive = state and true or false
    end

    if not getgenv().Xvlamer_KnobFarmActive then
        return
    end

    getgenv().Xvlamer_KnobFarmThread = task.spawn(function()
        local remotesFolder = ReplicatedStorage:WaitForChild("RemotesFolder", 10)
        local statisticsRemote = remotesFolder and remotesFolder:WaitForChild("Statistics", 10)

        while getgenv().Xvlamer_KnobFarmActive do
            pcall(function()
                if typeof(replicatesignal) == "function" then
                    replicatesignal(LocalPlayer.Kill)
                else
                    local char = LocalPlayer.Character
                    if char then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 then
                            hum.Health = 0
                        end
                    end
                end

                if statisticsRemote then
                    statisticsRemote:FireServer()
                end
            end)

            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    pcall(function() hum.Died:Wait() end)
                end
            end

            task.wait(0.3)

            local t = tick()
            repeat
                task.wait(0.1)
                char = LocalPlayer.Character
            until (char and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").Health > 0) or (tick() - t > 5)

            task.wait(0.25 + (math.random(1, 5) / 100))
        end
    end)
end

getgenv().Xvlamer_SetKnobFarm = setKnobFarm

return setKnobFarm
