local function runStatsLoop()
    local startKnobs = getKnobValue()
    local samples = {}
    
    table.insert(samples, { t = os.clock(), k = startKnobs })
    
    local lastRateUpdate = 0
    local lastKnownKnobs = -1

    while not shouldStop() do
        if not overlayGui or not overlayGui.Parent then
            buildOverlay()
            lastKnownKnobs = -1
            lastRateUpdate = 0
        end

        hideGameUIs()

        local now = os.clock()
        local currentKnobs = getKnobValue()

        if currentKnobs ~= lastKnownKnobs then
            local earned = math.max(0, currentKnobs - startKnobs)
            if overlayFrame then
                pcall(function()
                    overlayFrame.current.Text = formatNumber(currentKnobs)
                    overlayFrame.earned.Text = "+" .. formatNumber(earned)
                end)
            end
            lastKnownKnobs = currentKnobs
        end

        table.insert(samples, { t = now, k = currentKnobs })

        while #samples > 0 and (now - samples[1].t) > 60 do
            table.remove(samples, 1)
        end

        if now - lastRateUpdate >= 1 then
            local rate = 0
            if #samples >= 2 then
                local oldest = samples[1]
                local newest = samples[#samples]
                local dt = newest.t - oldest.t
                local dk = math.max(0, newest.k - oldest.k)
                
                if dt > 0 then
                    rate = (dk / dt) * 3600
                end
            end

            if overlayFrame then
                pcall(function()
                    overlayFrame.perHour.Text = formatNumber(rate) .. " / hr"
                end)
            end
            lastRateUpdate = now
        end

        task.wait(0.02)
    end
end

buildOverlay()
task.spawn(runStatsLoop)

task.spawn(function()
    while not shouldStop() do
        pcall(function()
            executeKill()
            if statisticsRemote then
                statisticsRemote:FireServer()
            end
        end)
        task.wait(0.02)
    end

    getgenv().XvlamerStop_KnobFarm = true
    getgenv().XvlamerHub_KnobFarmCancelled = true
    
    restoreGameUIs()

    pcall(function()
        if overlayGui then
            overlayGui:Destroy()
            overlayGui = nil
            overlayFrame = nil
        end
    end)
end)
