local function runStatsLoop()
    local startKnobs = getKnobValue()
    local rateHistory = {}
    local currentRate = 0
    local lastRateUpdate = os.clock()

    task.spawn(function()
        while not shouldStop() do
            if overlayGui == nil or overlayGui.Parent == nil then
                buildOverlay()
            end

            local now = os.clock()
            local currentKnobs = getKnobValue()

            table.insert(rateHistory, {t = now, k = currentKnobs})

            local cutoff = now - 30
            while #rateHistory > 0 and rateHistory[1].t < cutoff do
                table.remove(rateHistory, 1)
            end

            if now - lastRateUpdate >= 5 then
                if #rateHistory > 1 then
                    local oldest = rateHistory[1]
                    local newest = rateHistory[#rateHistory]
                    local dt = newest.t - oldest.t
                    local dk = newest.k - oldest.k
                    
                    if dt > 0 then
                        currentRate = (dk / dt) * 3600
                    end
                end

                if overlayFrame then
                    pcall(function()
                        overlayFrame.perHour.Text = formatNumber(currentRate) .. " / hr"
                    end)
                end
                lastRateUpdate = now
            end
            
            task.wait(0.1)
        end
    end)

    task.spawn(function()
        local lastKnobs = -1
        while not shouldStop() do
            local currentKnobs = getKnobValue()
            if currentKnobs ~= lastKnobs then
                local earned = math.max(0, currentKnobs - startKnobs)
                if overlayFrame then
                    pcall(function()
                        overlayFrame.current.Text = formatNumber(currentKnobs)
                        overlayFrame.earned.Text = "+" .. formatNumber(earned)
                    end)
                end
                lastKnobs = currentKnobs
            end
            task.wait(0.05)
        end
    end)
end

buildOverlay()
task.spawn(runStatsLoop)

