local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer

if getgenv().XvlamerStop_KnobFarm ~= nil then
    getgenv().XvlamerStop_KnobFarm = true
    task.wait(0.1)
end

getgenv().XvlamerStop_KnobFarm = false
getgenv().XvlamerHub_KnobFarmCancelled = false

local remotesFolder = ReplicatedStorage:WaitForChild("RemotesFolder", 10)
local statisticsRemote = remotesFolder and remotesFolder:WaitForChild("Statistics", 10)

local function executeKill()
    if typeof(replicatesignal) == "function" then
        pcall(replicatesignal, LocalPlayer.Kill)
    end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            hum.Health = 0
        end
    end
end

local function shouldStop()
    return getgenv().XvlamerStop_KnobFarm == true
        or getgenv().XvlamerHub_KnobFarmCancelled == true
        or getgenv().XvlamerHub_Cancelled == true
end

local function getKnobValue()
    local val = 0
    pcall(function()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if not pg then return end
        local topbarUI = pg:FindFirstChild("TopbarUI")
        if not topbarUI then return end
        local topbar = topbarUI:FindFirstChild("Topbar")
        if not topbar then return end
        local knobsLabel = topbar:FindFirstChild("Knobs")
        if knobsLabel and knobsLabel:IsA("TextLabel") then
            local raw = knobsLabel.Text:gsub(",", ""):gsub("%s", "")
            val = tonumber(raw) or 0
        end
    end)
    return val
end

local overlayGui, overlayFrame
local hiddenGuis = {}

local function hideGameUIs()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return end

    for _, gui in ipairs(pg:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= "XvlamersKnobOverlay" and gui.Enabled then
            if not gui.Name:match("Xvlamer") then
                hiddenGuis[gui] = true
                gui.Enabled = false
            end
        end
    end
end

local function restoreGameUIs()
    for gui, _ in pairs(hiddenGuis) do
        if gui and gui.Parent then
            gui.Enabled = true
        end
    end
    table.clear(hiddenGuis)
end

local function formatNumber(n)
    local formatted = tostring(math.floor(n))
    local k
    while true do
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", '%1,%2')
        if k == 0 then break end
    end
    return formatted
end

