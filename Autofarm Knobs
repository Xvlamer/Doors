local statisticsRemote = remotesFolder and remotesFolder:WaitForChild("Statistics", 10)

local function executeKill()
    if typeof(replicatesignal) == "function" then
        pcall(replicatesignal, LocalPlayer.Kill)
    end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            hum.Health = 0
        end
    end
end

local function shouldStop()
    return getgenv().XvlamerStop_KnobFarm == true
        or getgenv().XvlamerHub_KnobFarmCancelled == true
        or getgenv().XvlamerHub_Cancelled == true
end

local function getKnobValue()
    local val = 0
    pcall(function()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if not pg then return end
        local topbarUI = pg:FindFirstChild("TopbarUI")
        if not topbarUI then return end
        local topbar = topbarUI:FindFirstChild("Topbar")
        if not topbar then return end
        local knobsLabel = topbar:FindFirstChild("Knobs")
        if knobsLabel and knobsLabel:IsA("TextLabel") then
            local raw = knobsLabel.Text:gsub(",", ""):gsub("%s", "")
            val = tonumber(raw) or 0
        end
    end)
    return val
end

local overlayGui, overlayFrame

local function formatNumber(n)
    local formatted = tostring(math.floor(n))
    local k
    while true do
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", '%1,%2')
        if k == 0 then break end
    end
    return formatted
end

