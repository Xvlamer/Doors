local function clearTargetVisuals(p)
	pcall(function()
		local data = targetVisualData[p]
		if data then
			if data.tag and data.tag.Parent then
				data.tag:Destroy()
			end
			if data.highlight and data.highlight.Parent then
				data.highlight:Destroy()
			end
			targetVisualData[p] = nil
		end
	end)
end

local function updateTargetVisuals(p)
	pcall(function()
		if not selectedTargets[p] then
			clearTargetVisuals(p)
			return
		end

		local char = p.Character
		if not char or not char:FindFirstChild("Head") or not char:FindFirstChild("HumanoidRootPart") then
			clearTargetVisuals(p)
			return
		end

		if not targetVisualData[p] then
			targetVisualData[p] = {}
			
			local bg = Instance.new("BillboardGui")
			bg.Name = "TargetInfoTag"
			bg.Size = UDim2.new(0, 160, 0, 50)
			bg.StudsOffset = Vector3.new(0, 2.8, 0)
			bg.AlwaysOnTop = true
			bg.Parent = char.Head

			local label = Instance.new("TextLabel")
			label.Name = "InfoLabel"
			label.Size = UDim2.new(1, 0, 1, 0)
			label.BackgroundTransparency = 1
			label.TextColor3 = Color3.fromRGB(255, 255, 255)
			label.TextStrokeTransparency = 0
			label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
			label.TextSize = 13
			label.Font = Enum.Font.GothamBold
			label.TextWrapped = true
			label.Parent = bg
			
			targetVisualData[p].tag = bg
			targetVisualData[p].label = label

			local highlight = Instance.new("Highlight")
			highlight.Name = "TargetESP"
			highlight.Adornee = char
			highlight.FillColor = Color3.fromRGB(15, 15, 20)
			highlight.FillTransparency = 0.5
			highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
			highlight.OutlineTransparency = 0.5
			highlight.Parent = char

			targetVisualData[p].highlight = highlight
		end

		local label = targetVisualData[p].label
		local localHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if label and localHrp then
			local dist = math.floor((localHrp.Position - char.HumanoidRootPart.Position).Magnitude + 0.5)
			label.Text = "@" .. p.Name .. "\n" .. dist .. " studs"
		end
	end)
end

