local function findNearestChair(exclude)
    local root=getRoot() if not root then return nil end
    local best=nil local bestDist=math.huge
    local function check(d)
        if d.Name~="ArchivesOfficeChair" or not d:IsA("Model") then return end
        if exclude and d==exclude then return end
        local dist=(root.Position-getChairPos(d)).Magnitude
        if dist<bestDist then bestDist=dist best=d end
    end
    for _,d in ipairs(miscFolder:GetDescendants()) do check(d) end
    for i=0,50 do
        local rf=currentRoomsFolder:FindFirstChild(tostring(i))
        if rf then for _,d in ipairs(rf:GetDescendants()) do check(d) end end
    end
    return best
end

-- Explicit grab only — never called by proximity signal
local function grabAndBypass(chair)
    if isCancelled() then return false end
    local cartPrompt=getCartPrompt(chair)
    local seatPrompt=getSeatPrompt(chair)
    if not cartPrompt or not seatPrompt then
        warn("[GRAB] Missing prompts on",chair.Name) return false
    end
    warn("[GRAB] Attempting",chair.Name)

    local grabStart=tick() local owned=false
    while tick()-grabStart<8 do
        if isCancelled() then return false end
        safeFirePrompt(cartPrompt)
        pcall(function() cartControlRemote:FireServer() end)
        task.wait(GRAB_INTERVAL)
        if tostring(chair:GetAttribute("LastPusherId"))==playerUserId then
            owned=true break
        end
    end
    if not owned then warn("[GRAB] Not owned") return false end
    warn("[GRAB] Owned")

    pcall(function() cartControlRemote:FireServer() end)
    task.wait(0.15)
    if isCancelled() then return false end

    lockChairParts(chair)
    disableChairPrompts(chair)
    doSeatCycle(seatPrompt)
    anchorToPlayer(chair,seatPrompt)

    local ws=tick() local confirmed=false
    while tick()-ws<5 do
        if isCancelled() then return false end
        local c=getChar()
        if c and c:GetAttribute("SeatedInSeat")==false then
            confirmed=true break
        end
        task.wait(0.1)
    end
    task.wait(1)
    warn("[GRAB] Confirmed:",confirmed,"AC:",anticheatOn)
    return confirmed and anticheatOn
end

-- Room 0: tween WP1->WP2->WP3->WP4 then tween to grab pos at walk speed
local function acquireFirstChair()
    if isCancelled() then return false end
    warn("[INIT] WP1")
    tweenToPos(WP1,SPEED_WALK_XZ,SPEED_WALK_Y,ARRIVE_DIST)
    if isCancelled() then return false end
    warn("[INIT] WP2")
    tweenToPos(WP2,SPEED_WALK_XZ,SPEED_WALK_Y,ARRIVE_DIST)
    if isCancelled() then return false end
    warn("[INIT] WP3")
    tweenToPos(WP3,SPEED_WALK_XZ,SPEED_WALK_Y,ARRIVE_DIST)
    if isCancelled() then return false end
    warn("[INIT] WP4")
    tweenToPos(WP4,SPEED_WALK_XZ,SPEED_WALK_Y,ARRIVE_DIST)
    if isCancelled() then return false end

    local chair=findNearestChair(nil)
    local ss=tick()
    while not chair do
        if isCancelled() then return false end
        if tick()-ss>CHAIR_SEARCH_LIMIT then warn("[INIT] Chair not found") return false end
        task.wait(0.3) chair=findNearestChair(nil)
    end
    warn("[INIT] Chair found:",chair.Name)

    local grabPos=getGrabPosition(chair)
    tweenToPos(grabPos,SPEED_WALK_XZ,SPEED_WALK_Y,ARRIVE_DIST)
    if isCancelled() then return false end

    return grabAndBypass(chair)
end

-- Rooms 10/20/30/40: tween to new chair while anchored, grab new, drop old only after owned
local function switchChair()
    local ss=tick()
    local newChair=findNearestChair(activeChair)
    while not newChair do
        if isCancelled() then return false end
        if tick()-ss>CHAIR_SEARCH_LIMIT then break end
        task.wait(0.3) newChair=findNearestChair(activeChair)
    end
    if not newChair then warn("[SWITCH] No chair found") return false end
    warn("[SWITCH] Switching to",newChair.Name)

    local cartPrompt=getCartPrompt(newChair)
    local seatPrompt=getSeatPrompt(newChair)
    if not cartPrompt or not seatPrompt then return false end

    local grabPos=getGrabPosition(newChair)
    tweenToPos(grabPos,SPEED_SWITCH_XZ,SPEED_Y,ARRIVE_DIST)
    if isCancelled() then return false end

    -- Grab new before releasing old
    local grabStart=tick() local owned=false
    while tick()-grabStart<8 do
        if isCancelled() then return false end
        safeFirePrompt(cartPrompt)
        pcall(function() cartControlRemote:FireServer() end)
        task.wait(GRAB_INTERVAL)
        if tostring(newChair:GetAttribute("LastPusherId"))==playerUserId then
            owned=true break
        end
    end
    if not owned then warn("[SWITCH] Not owned") return false end

    stopAnchor()
    pcall(function() cartControlRemote:FireServer() end)
    task.wait(0.15)
    if isCancelled() then return false end

    lockChairParts(newChair)
    disableChairPrompts(newChair)
    doSeatCycle(seatPrompt)
    anchorToPlayer(newChair,seatPrompt)

    local ws=tick() local confirmed=false
    while tick()-ws<5 do
        if isCancelled() then return false end
        local c=getChar()
        if c and c:GetAttribute("SeatedInSeat")==false then confirmed=true break end
        task.wait(0.1)
    end
    task.wait(1)
    warn("[SWITCH] Done. Confirmed:",confirmed)
    return confirmed and anticheatOn
end

local function acquireAnyChair()
    if isCancelled() then return false end
    local ss=tick()
    local chair=findNearestChair(nil)
    local useSlow=false
    while not chair do
        if isCancelled() then return false end
        if tick()-ss>CHAIR_SEARCH_LIMIT then useSlow=true break end
        task.wait(0.3) chair=findNearestChair(nil)
    end
    if not chair then warn("[ACQUIRE] No chair") return false end
    local grabPos=getGrabPosition(chair)
    tweenToPos(grabPos,useSlow and SPEED_NOCLIP_XZ or SPEED_SWITCH_XZ,SPEED_Y,ARRIVE_DIST)
    if isCancelled() then return false end
    return grabAndBypass(chair)
end

local function getRoomFolder(n) return currentRoomsFolder:FindFirstChild(tostring(n)) end

