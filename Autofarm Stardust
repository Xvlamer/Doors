local function applyESP(chair)
	pcall(function()
		if not chair:FindFirstChild("BlueESP") then
			local highlight = Instance.new("Highlight")
			highlight.Name = "BlueESP"
			highlight.FillColor = Color3.fromRGB(0, 100, 255)
			highlight.OutlineColor = Color3.fromRGB(100, 180, 255)
			highlight.Parent = chair
		end
	end)
end

local function removeESP(chair)
	pcall(function()
		local esp = chair:FindFirstChild("BlueESP")
		if esp then esp:Destroy() end
	end)
end

local function registerChair(obj)
	pcall(function()
		if obj.Name == targetName then
			if not table.find(knownChairs, obj) then
				table.insert(knownChairs, obj)
			end
			local prompt = obj:FindFirstChild("CartPrompt", true)
			if prompt then
				prompt.SoundId = ""
			end
		end
	end)
end

descendantAddedConn = Workspace.DescendantAdded:Connect(registerChair)
descendantRemovingConn = Workspace.DescendantRemoving:Connect(function(obj)
	collectedChairsMap[obj] = nil
	local idx = table.find(knownChairs, obj)
	if idx then table.remove(knownChairs, idx) end
end)

for _, obj in ipairs(Workspace:GetDescendants()) do
	registerChair(obj)
end

task.spawn(function()
	while isRunning do
		pcall(function()
			collectedChairs = {}
			for chair, _ in pairs(collectedChairsMap) do
				if chair and chair.Parent then
					table.insert(collectedChairs, chair)
				end
			end
			status.Text = "Chairs Ready: " .. #collectedChairs
		end)
		task.wait(0.05)
	end
end)

RunService.Heartbeat:Connect(function(dt)
	if not isRunning then return end
	local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	local targetsChanged = false
	for p, _ in pairs(selectedTargets) do
		local char = p.Character
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		
		local shouldRemove = false
		if not char or not humanoid or humanoid.Health <= 0 then
			shouldRemove = true
		elseif hrp and rootPart then
			local dist = (hrp.Position - rootPart.Position).Magnitude
			if dist > 10000 then
				shouldRemove = true
			end
		elseif not hrp then
			shouldRemove = true
		end

		if shouldRemove then
			selectedTargets[p] = nil
			clearTargetVisuals(p)
			targetsChanged = true
		else
			updateTargetVisuals(p)
		end
	end
	
	if targetsChanged then
		updatePlayerList()
		local count = 0
		for _ in pairs(selectedTargets) do count = count + 1 end
		if count == 0 then
			title.Text = "Chair Admin Panel"
		else
			title.Text = "Targets: " .. count
		end
	end

	local miscFolder = Workspace:FindFirstChild("Misc")
	local remote = ReplicatedStorage:FindFirstChild("RemotesFolder") and ReplicatedStorage.RemotesFolder:FindFirstChild("CartControl")

	local availableChairs = {}

	for _, chair in ipairs(knownChairs) do
		if chair and chair.Parent then
			pcall(function()
				local inMisc = miscFolder and chair:IsDescendantOf(miscFolder)
				
				if inMisc then
					removeESP(chair)
					collectedChairsMap[chair] = true
					
					if not chair:GetAttribute("ReleasedInMisc") then
						chair:SetAttribute("ReleasedInMisc", true)
						if remote then
							task.spawn(function()
								pcall(function() remote:FireServer() end)
							end)
						end
					end
				else
					chair:SetAttribute("ReleasedInMisc", nil)
					collectedChairsMap[chair] = nil

					if collectorEnabled then
						applyESP(chair)
					else
						removeESP(chair)
					end

					local primary = chair:IsA("Model") and (chair.PrimaryPart or chair:FindFirstChildWhichIsA("BasePart")) or chair
					if primary then
						local dist = (rootPart.Position - primary.Position).Magnitude
						if dist <= 20 then
							local prompt = chair:FindFirstChild("CartPrompt", true)
							if prompt then
								table.insert(availableChairs, {chair = chair, prompt = prompt, dist = dist})
							end
						end
					end
				end
			end)
		end
	end

	if tick() - lastGrabTime >= 0.05 then
		lastGrabTime = tick()
		
		table.sort(availableChairs, function(a, b)
			return a.dist < b.dist
		end)

		for _, item in ipairs(availableChairs) do
			pcall(function()
				item.chair:SetAttribute("LastPusherId", player.UserId)
				fireproximityprompt(item.prompt)
			end)
			if remote then
				task.spawn(function()
					pcall(function() remote:FireServer() end)
				end)
			end
		end
	end

	if currentMode == "Kill" then
		if tick() - killTimer > 5 then
			currentMode = "None"
			jailPositions = {}
		end
	elseif currentMode == "Fling" then
		if tick() - flingTimer > 1 then
			currentMode = "None"
			jailPositions = {}
		end
	end

	local activeTargets = {}
	for p, _ in pairs(selectedTargets) do
		if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			table.insert(activeTargets, p)
		end
	end

	local assignedChairs = {}
	local numTargets = #activeTargets

	if currentMode == "Jail" then
	elseif currentMode == "Orbit" and numTargets > 0 then
		local chairsPerTarget = math.floor(#collectedChairs / numTargets)
		local remainder = #collectedChairs % numTargets
		
		local chairIndex = 1
		for tIdx, p in ipairs(activeTargets) do
			local tHrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if tHrp then
				local countForThisTarget = chairsPerTarget + (tIdx <= remainder and 1 or 0)
				local targetChairs = {}
				for i = 1, countForThisTarget do
					if collectedChairs[chairIndex] then
						table.insert(targetChairs, collectedChairs[chairIndex])
						chairIndex = chairIndex + 1
					end
				end
				
				for localIdx, chair in ipairs(targetChairs) do
					assignedChairs[chair] = {
						HRP = tHrp,
						Type = "Orbit",
						Index = localIdx,
						Total = #targetChairs
					}
				end
			end
		end
	elseif currentMode == "Throw" then
	elseif currentMode == "Fling" and numTargets > 0 then
		local chairIdx = 1
		for _, p in ipairs(activeTargets) do
			local tHrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if tHrp then
				for i = 1, 3 do
					local chair = collectedChairs[chairIdx]
					if chair then
						assignedChairs[chair] = { HRP = tHrp, Type = "Fling", Index = i }
						chairIdx = chairIdx + 1
					end
				end
			end
		end
	elseif numTargets > 0 and #collectedChairs > 0 and currentMode == "Kill" then
		local chairsPerTarget = math.floor(#collectedChairs / numTargets)
		local remainder = #collectedChairs % numTargets
		
		local chairIndex = 1
		for tIdx, p in ipairs(activeTargets) do
			local tHrp = p.Character.HumanoidRootPart
			local countForThisTarget = chairsPerTarget + (tIdx <= remainder and 1 or 0)
			
			local targetChairs = {}
			for i = 1, countForThisTarget do
				if collectedChairs[chairIndex] then
					table.insert(targetChairs, collectedChairs[chairIndex])
					chairIndex = chairIndex + 1
				end
			end
			
			for localIdx, chair in ipairs(targetChairs) do
				assignedChairs[chair] = {
					HRP = tHrp,
					Type = currentMode,
					Index = localIdx,
					Total = #targetChairs
				}
			end
		end
	end

	local localHumanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local isLocalDead = (not localHumanoid) or (localHumanoid.Health <= 0)

	if not isLocalDead then
		cachedDeadTarget = nil
	elseif isLocalDead and not cachedDeadTarget then
		local otherPlayers = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				table.insert(otherPlayers, p)
			end
		end
		if #otherPlayers > 0 then
			cachedDeadTarget = otherPlayers[math.random(1, #otherPlayers)]
		end
	end

	for i, chair in ipairs(collectedChairs) do
		if not chair or not chair.Parent then continue end
		pcall(function()
			chair:SetAttribute("LastPusherId", player.UserId)
			local assignment = assignedChairs[chair]
			
			if currentMode == "Jail" then
				local targetPos = jailPositions[chair] or (rootPart.Position - Vector3.new(0, 30, 0))
				local targetCf = CFrame.new(targetPos)
				if chair:IsA("Model") then
					chair:PivotTo(targetCf)
				elseif chair:IsA("BasePart") then
					chair.CFrame = targetCf
				end
				for _, part in ipairs(chair:GetDescendants()) do
					if part:IsA("BasePart") then
						part.Anchored = true
						part.CanCollide = true
						part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
						part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
					end
				end
			elseif currentMode == "Orbit" and numTargets == 0 then
				local totalChairs = #collectedChairs
				local radius = 12
				local spinSpeed = 10
				local angle = ((i - 1) * (2 * math.pi / totalChairs)) + (tick() * spinSpeed)
				local x = math.cos(angle) * radius
				local z = math.sin(angle) * radius
				
				local ySpread = ((i - (totalChairs + 1) / 2) * 0.8) + (math.sin(tick() * 10 + i) * 1.5)
				local targetPos = rootPart.Position + Vector3.new(x, ySpread, z)
				local targetCf = CFrame.new(targetPos)

				if chair:IsA("Model") then
					chair:PivotTo(targetCf)
				elseif chair:IsA("BasePart") then
					chair.CFrame = targetCf
				end
				for _, part in ipairs(chair:GetDescendants()) do
					if part:IsA("BasePart") then
						part.Anchored = true
						part.CanCollide = false
					end
				end
			elseif assignment and assignment.Type == "Orbit" then
				local targetHRP = assignment.HRP
				local idx = assignment.Index
				local totalChairs = assignment.Total
				local radius = 12
				local spinSpeed = 10
				local angle = ((idx - 1) * (2 * math.pi / math.max(totalChairs, 1))) + (tick() * spinSpeed)
				local x = math.cos(angle) * radius
				local z = math.sin(angle) * radius
				
				local ySpread = ((idx - (totalChairs + 1) / 2) * 0.8) + (math.sin(tick() * 10 + idx) * 1.5)
				local targetPos = targetHRP.Position + Vector3.new(x, ySpread, z)
				local targetCf = CFrame.new(targetPos)

				if chair:IsA("Model") then
					chair:PivotTo(targetCf)
				elseif chair:IsA("BasePart") then
					chair.CFrame = targetCf
				end
				for _, part in ipairs(chair:GetDescendants()) do
					if part:IsA("BasePart") then
						part.Anchored = true
						part.CanCollide = false
					end
				end
			elseif currentMode == "Throw" then
				local primary = chair:IsA("Model") and (chair.PrimaryPart or chair:FindFirstChildWhichIsA("BasePart")) or chair
				if primary then
					local chairPos = primary.Position
					local diff = chairPos - rootPart.Position
					local distFromPlayer = diff.Magnitude

					if math.abs(diff.X) <= 4.5 and math.abs(diff.Y) <= 4.5 and math.abs(diff.Z) <= 4.5 then
						chair:SetAttribute("IsThrown", nil)
						for _, part in ipairs(chair:GetDescendants()) do
							if part:IsA("BasePart") then
								part.Anchored = false
								part.CanCollide = false
								local pushDir = (diff.Magnitude > 0) and diff.Unit or Vector3.new(0, 1, 0)
								part.AssemblyLinearVelocity = (pushDir * 500) + Vector3.new(0, 150, 0)
								part.AssemblyAngularVelocity = Vector3.new(math.random(-800, 800), math.random(-800, 800), math.random(-800, 800))
							end
						end
					elseif distFromPlayer > 500 then
						chair:SetAttribute("IsThrown", nil)
						local resetPos = rootPart.Position - Vector3.new(0, 30, 0)
						local targetCf = CFrame.new(resetPos)
						if chair:IsA("Model") then
							chair:PivotTo(targetCf)
						elseif chair:IsA("BasePart") then
							chair.CFrame = targetCf
						end
						for _, part in ipairs(chair:GetDescendants()) do
							if part:IsA("BasePart") then
								part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
								part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
							end
						end
					elseif not chair:GetAttribute("IsThrown") then
						chair:SetAttribute("IsThrown", true)
						
						local frontCenter = rootPart.Position + (rootPart.CFrame.LookVector * 15) + Vector3.new(0, 2, 0)
						local angle = (i - 1) * (2 * math.pi / math.max(#collectedChairs, 1))
						local spread = Vector3.new(math.cos(angle) * 2.5, (i % 2) * 1.2, math.sin(angle) * 2.5)
						local targetPos = frontCenter + spread
						local targetCf = CFrame.new(targetPos)

						if chair:IsA("Model") then
							chair:PivotTo(targetCf)
						elseif chair:IsA("BasePart") then
							chair.CFrame = targetCf
							chair.Anchored = true
						end

						task.delay(0.01, function()
							if chair and chair.Parent then
								for _, part in ipairs(chair:GetDescendants()) do
									if part:IsA("BasePart") then
										part.Anchored = false
										part.CanCollide = false
										local lookDir = rootPart.CFrame.LookVector
										part.AssemblyLinearVelocity = (lookDir * 400) + Vector3.new(0, math.random(40, 80), 0)
										part.AssemblyAngularVelocity = Vector3.new(math.random(-800, 800), math.random(-800, 800), math.random(-800, 800))
									end
								end
							end
						end)
					end
				end
			elseif assignment and assignment.Type == "Fling" then
				local targetHRP = assignment.HRP
				local idx = assignment.Index
				local angle = (idx - 1) * (2 * math.pi / 3)
				local x = math.cos(angle) * 0.5
				local z = math.sin(angle) * 0.5
				local targetPos = targetHRP.Position + Vector3.new(x, -2, z)
				local targetCf = CFrame.new(targetPos)
				
				if chair:IsA("Model") then
					chair:PivotTo(targetCf)
				elseif chair:IsA("BasePart") then
					chair.CFrame = targetCf
				end
				for _, part in ipairs(chair:GetDescendants()) do
					if part:IsA("BasePart") then
						part.Anchored = false
						part.CanCollide = false
						part.AssemblyLinearVelocity = Vector3.new(math.random(-250, 250), math.random(500, 800), math.random(-250, 250))
						part.AssemblyAngularVelocity = Vector3.new(math.random(-99999, 99999), math.random(-99999, 99999), math.random(-99999, 99999))
					end
				end
			elseif assignment and assignment.Type == "Kill" then
				local targetHRP = assignment.HRP
				local idx = assignment.Index
				-- PSYCHO APESHIT MODE: Extreme speed, massive chaos
				local timeVal = tick() * 180 + (idx * 3.7)
				local radius = 1.5 + math.sin(tick() * 70 + idx) * 3.0
				local x = math.cos(timeVal) * radius
				local z = math.sin(timeVal) * radius
				local yOffset = math.sin(tick() * 90 + idx) * 5 + 1.0
				
				-- Violently snap right inside and around the target's body with pure psycho chaos
				local targetPos = targetHRP.Position + Vector3.new(x, yOffset, z) + Vector3.new(math.random(-4, 4), math.random(-3, 5), math.random(-4, 4))
				local targetCf = CFrame.new(targetPos) * CFrame.Angles(math.rad(math.random(-360, 360)), math.rad(math.random(-360, 360)), math.rad(math.random(-360, 360)))

				if chair:IsA("Model") then
					chair:PivotTo(targetCf)
				elseif chair:IsA("BasePart") then
					chair.CFrame = targetCf
				end
				for _, part in ipairs(chair:GetDescendants()) do
					if part:IsA("BasePart") then
						part.Anchored = false
						part.CanCollide = false
						part.AssemblyLinearVelocity = Vector3.new(math.random(-2000, 2000), math.random(1500, 3500), math.random(-2000, 2000))
						part.AssemblyAngularVelocity = Vector3.new(math.random(-999999, 999999), math.random(-999999, 999999), math.random(-999999, 999999))
					end
				end
			else
				local targetPos
				if isLocalDead and cachedDeadTarget and cachedDeadTarget.Character and cachedDeadTarget.Character:FindFirstChild("HumanoidRootPart") then
					targetPos = cachedDeadTarget.Character.HumanoidRootPart.Position - Vector3.new(0, 30, (i % 5) * 2)
				else
					targetPos = rootPart.Position - Vector3.new(0, 30, (i % 5) * 2)
				end
				local targetCf = CFrame.new(targetPos)

				if chair:IsA("Model") then
					chair:PivotTo(targetCf)
				elseif chair:IsA("BasePart") then
					chair.CFrame = targetCf
				end
				for _, part in ipairs(chair:GetDescendants()) do
					if part:IsA("BasePart") then
						part.Anchored = true
						part.CanCollide = false
						part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
						part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
					end
				end
			end
		end)
	end
end)
