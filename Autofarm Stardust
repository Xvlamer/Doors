-- hookChair: registers only. Zero auto-grab logic.
local function hookChair(chair)
    if chair.Name~="ArchivesOfficeChair" then return end
    if allChairs[chair] then return end
    allChairs[chair]=true
    chair.AncestryChanged:Connect(function()
        if not chair.Parent then
            allChairs[chair]=nil
            if activeChair==chair then stopAnchor() end
        end
    end)
end

local function scanFolder(folder)
    for _,d in ipairs(folder:GetDescendants()) do
        if d.Name=="ArchivesOfficeChair" and d:IsA("Model") then hookChair(d) end
    end
    folder.DescendantAdded:Connect(function(d)
        if d.Name=="ArchivesOfficeChair" and d:IsA("Model") then hookChair(d) end
    end)
end
