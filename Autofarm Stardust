-- Separate X/Z and Y speeds. Y capped at 50 to prevent ground clipping.
-- Player velocity zeroed every heartbeat. No raycast — geometry does not exist.
local function tweenToPos(targetPos, xzSpeed, ySpeed, stopDist)
    if typeof(targetPos)=="CFrame" then targetPos=targetPos.Position end
    if tweenConn then tweenConn:Disconnect() tweenConn=nil end
    if isCancelled() then return false end
    stopDist = stopDist or ARRIVE_DIST
    xzSpeed  = xzSpeed or SPEED_XZ
    ySpeed   = ySpeed  or SPEED_Y
    local done=false local result=false
    tweenConn = RunService.Heartbeat:Connect(function(dt)
        if done then return end
        if isCancelled() then done=true result=false return end
        local root=getRoot()
        if not root then done=true result=false return end
        root.AssemblyLinearVelocity  = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        local hum=getChar() and getChar():FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand=true end
        local cur  = root.Position
        local diff = targetPos - cur
        local dist = diff.Magnitude
        if dist<=stopDist then
            if hum then hum.PlatformStand=false end
            done=true result=true return
        end
        -- Move X/Z and Y independently at different speeds
        local dx = diff.X
        local dy = diff.Y
        local dz = diff.Z
        local xzDist = math.sqrt(dx*dx+dz*dz)
        local newX = cur.X + (xzDist>0 and (dx/xzDist)*math.min(xzDist,xzSpeed*dt) or 0)
        local newZ = cur.Z + (xzDist>0 and (dz/xzDist)*math.min(xzDist,xzSpeed*dt) or 0)
        local newY = cur.Y + (math.abs(dy)>0 and (dy/math.abs(dy))*math.min(math.abs(dy),ySpeed*dt) or 0)
        root.CFrame = CFrame.new(Vector3.new(newX,newY,newZ)) * root.CFrame.Rotation
    end)
    while not done do task.wait(0.05) end
    if tweenConn then tweenConn:Disconnect() tweenConn=nil end
    local hum=getChar() and getChar():FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand=false end
    return result
end

local function safeFirePrompt(prompt)
    if not prompt or not prompt.Parent then return end
    pcall(fireproximityprompt,prompt)
end

