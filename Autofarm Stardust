local function grabAndBypass(chair)
    if isCancelled() then return false end
    local cartPrompt = getCartPrompt(chair)
    local seatPrompt = getSeatPrompt(chair)
    if not cartPrompt or not seatPrompt then return false end

    local grabStart = tick()
    local owned = false
    while tick() - grabStart < 8 do
        if isCancelled() then return false end
        safeFirePrompt(cartPrompt)
        pcall(function() cartControlRemote:FireServer() end)
        task.wait(GRAB_INTERVAL)
        if tostring(chair:GetAttribute("LastPusherId")) == playerUserId then
            owned = true break
        end
    end
    if not owned then return false end

    pcall(function() cartControlRemote:FireServer() end)
    task.wait(0.15)
    if isCancelled() then return false end

    lockChairParts(chair)
    disableChairPrompts(chair)
    doSeatCycle(seatPrompt)
    anchorToPlayer(chair, seatPrompt)

    local ws = tick()
    local confirmed = false
    while tick() - ws < 5 do
        if isCancelled() then return false end
        local c = getChar()
        if c and c:GetAttribute("SeatedInSeat") == false then
            confirmed = true
            break
        end
        task.wait(0.1)
    end
    
    task.wait(1)
    return confirmed and anticheatOn
end

local function hookChair(chair)
    if chair.Name ~= "ArchivesOfficeChair" then return end
    if allChairs[chair] then return end
    allChairs[chair] = true
    chair.AncestryChanged:Connect(function()
        if not chair.Parent then
            allChairs[chair] = nil
            if activeChair == chair then stopAnchor() end
        end
    end)
end

local function scanFolder(folder)
    for _,d in ipairs(folder:GetDescendants()) do
        if d.Name == "ArchivesOfficeChair" and d:IsA("Model") then hookChair(d) end
    end
    folder.DescendantAdded:Connect(function(d)
        if d.Name == "ArchivesOfficeChair" and d:IsA("Model") then hookChair(d) end
    end)
end
