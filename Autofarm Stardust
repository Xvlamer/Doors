end

local function lootStardust(roomFolder)
    local seen={} local targets={}
    for _,d in ipairs(roomFolder:GetDescendants()) do
        if (d.Name:find("Stardust") or d.Name:find("stardust")) and not seen[d] then
            seen[d]=true table.insert(targets,d)
        end
    end
    local root=getRoot()
    if root then
        table.sort(targets,function(a,b)
            local function pos(x)
                if x:IsA("BasePart") then return x.Position end
                local m=x:FindFirstChild("Main")
                if m and m:IsA("BasePart") then return m.Position end
                return x:GetPivot().Position
            end
            return (root.Position-pos(a)).Magnitude<(root.Position-pos(b)).Magnitude
        end)
    end
    for _,target in ipairs(targets) do
        if isCancelled() then return end
        if not target.Parent then continue end
        local mainPart=(target:IsA("BasePart") and target)
            or target:FindFirstChild("Main")
            or target:FindFirstChildWhichIsA("BasePart")
        if mainPart and mainPart:IsA("BasePart") then lootMoveTo(mainPart.Position) end
        if isCancelled() then return end
        for _,d in ipairs(target:GetDescendants()) do
            if d:IsA("ProximityPrompt") then safeFirePrompt(d) end
        end
        if target:IsA("ProximityPrompt") then safeFirePrompt(target) end
        local ws=tick()
        while target.Parent and tick()-ws<2 do task.wait(0.05) end
    end
end

-- Desks: move to each desk, fire ALL drawer prompts at once, move on immediately
local function lootDesks(roomFolder)
    local assets=roomFolder:FindFirstChild("Assets") or roomFolder
    local desks={}
    for _,d in ipairs(assets:GetDescendants()) do
        if d:IsA("Model") and d.Name:match("^ArchivesDesk") then table.insert(desks,d) end
    end
    local root=getRoot()
    if root then
        table.sort(desks,function(a,b)
            return (root.Position-a:GetPivot().Position).Magnitude<(root.Position-b:GetPivot().Position).Magnitude
        end)
    end
    for _,desk in ipairs(desks) do
        if isCancelled() then return end
        if not desk.Parent then continue end
        -- Move to desk pivot
        lootMoveTo(desk:GetPivot().Position)
        if isCancelled() then return end
        -- Fire all drawer prompts simultaneously
        for _,child in ipairs(desk:GetDescendants()) do
            if child.Name=="DrawerContainer" and child:IsA("Model") then
                local knob=child:FindFirstChild("Knob") if not knob then continue end
                local prompt=knob:FindFirstChild("ActivateEventPrompt") or findPromptInModel(knob)
                if prompt then safeFirePrompt(prompt) end
            end
        end
        task.wait(0.1)
    end
    lootStardust(roomFolder)
end

local function lootHidingSpots(roomFolder)
    local assets=roomFolder:FindFirstChild("Assets") or roomFolder
    local spots={}
    for _,d in ipairs(assets:GetDescendants()) do
        if d:IsA("Model") and d.Name:match("^HidingSpot") then table.insert(spots,d) end
    end
    local root=getRoot()
    if root then
        table.sort(spots,function(a,b)
            return (root.Position-a:GetPivot().Position).Magnitude<(root.Position-b:GetPivot().Position).Magnitude
        end)
    end
    for _,spot in ipairs(spots) do
        if isCancelled() then return end
        if not spot.Parent then continue end
        local prompt=spot:FindFirstChild("InteractPrompt") or findPromptInModel(spot)
        if not prompt then continue end
        local pp=prompt.Parent
        if pp and pp:IsA("BasePart") then
            lootMoveTo((pp.CFrame*CFrame.new(0,0,-2)).Position)
        else
            lootMoveTo((spot:GetPivot()*CFrame.new(0,0,-2)).Position)
        end
        if isCancelled() then return end
        safeFirePrompt(prompt)
        task.wait(0.2)
        lootStardust(roomFolder)
    end
end

local function lootRoom(roomNum)
    if isCancelled() then return end
    local rf=getRoomFolder(roomNum) if not rf then return end
    warn("[LOOT] Room",roomNum)
    lootStardust(rf)
    if isCancelled() then return end
    lootDesks(rf)
    if isCancelled() then return end
    lootHidingSpots(rf)
    warn("[LOOT] Room",roomNum,"done")
end

local function firePlayAgain()
    pcall(function()
        ReplicatedStorage:WaitForChild("RemotesFolder"):WaitForChild("PlayAgain"):FireServer()
    end)
end

local function blockDroneRemotes(model)
    for _,d in ipairs(model:GetDescendants()) do
        if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
            if hookfunction then
                pcall(hookfunction,d.FireServer,function() end)
                pcall(hookfunction,d.InvokeServer,function() end)
            end
        end
    end
end
for _,obj in ipairs(Workspace:GetChildren()) do
    if obj:IsA("Model") and (obj.Name=="Drones" or obj.Name=="DronesStampede") then
        blockDroneRemotes(obj)
    end
end
Workspace.ChildAdded:Connect(function(obj)
    if obj:IsA("Model") and (obj.Name=="Drones" or obj.Name=="DronesStampede") then
        task.wait(0.1) blockDroneRemotes(obj)
    end
end)

local function roomLoop()
    while not isCancelled() do
        task.wait(0.05)
        if not anticheatOn then
            warn("[LOOP] AC off — reacquiring")
            local ok=false
            for _=1,3 do
                if isCancelled() then return end
                ok=acquireAnyChair() if ok then break end
                task.wait(1)
            end
            if not ok or isCancelled() then return end
        end

        local targetRoom=currentRoom+1
        warn("[LOOP] Opening door to room",targetRoom)
        local opened=openDoor(targetRoom)
        if isCancelled() then return end
        if not opened then task.wait(0.5) continue end

        local loaded=waitForRoom(targetRoom,12)
        if not loaded or isCancelled() then task.wait(1) continue end

        currentRoom=targetRoom
        warn("[LOOP] In room",currentRoom)

        -- Always wait 3 seconds, then loot if there's anything
        task.wait(3)
        if roomHasLootables(currentRoom) then
            lootRoom(currentRoom)
        end
        if isCancelled() then return end

        if currentRoom>=49 then
            warn("[LOOP] Done — PlayAgain")
            firePlayAgain()
            scriptRunning=false return
        end

        if CHAIR_ROOMS[currentRoom] then
            warn("[LOOP] Chair switch at room",currentRoom)
            local ok=false
            for _=1,3 do
                if isCancelled() then return end
                ok=switchChair() if ok then break end
                task.wait(1)
            end
            if not ok then warn("[LOOP] Switch failed — continuing") end
        end
    end
    scriptRunning=false
end

local function mainLoop()
    scriptRunning=true
    getgenv().XvlamerHub_StardustFarmCancelled=false
    task.wait(3)
    if isCancelled() then return end
    currentRoom=0
    warn("[MAIN] Start room 0")
    if not anticheatOn then
        local ok=acquireFirstChair()
        if not ok or isCancelled() then
            warn("[MAIN] Failed to acquire chair")
            scriptRunning=false return
        end
    end
    roomLoop()
end

local function resumeLoop()
    local best=0
    for i=50,0,-1 do if getRoomFolder(i) then best=i break end end
    currentRoom=best
    warn("[RESUME] Room",currentRoom)
    if not anticheatOn then
        local ok=acquireAnyChair()
        if not ok or isCancelled() then scriptRunning=false return end
    end
    roomLoop()
end

getgenv().XvlamerHub_StardustFarmCancelled=false
if scriptRunning then task.spawn(resumeLoop) else task.spawn(mainLoop) end
