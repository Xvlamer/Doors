        or not scriptRunning
end

local function tweenToPos(targetPos, speed, stopDist)
    if typeof(targetPos) == "CFrame" then targetPos = targetPos.Position end
    if tweenConn then tweenConn:Disconnect() tweenConn = nil end
    if isCancelled() then return false end
    stopDist = stopDist or ARRIVE_DIST
    speed = speed or (anticheatOn and SPEED_AC or SPEED_WALK)
    
    local done = false
    local result = false
    tweenConn = RunService.Heartbeat:Connect(function(dt)
        if done then return end
        if isCancelled() then done = true result = false return end
        local root = getRoot()
        if not root then done = true result = false return end
        local cur = root.Position
        local diff = targetPos - cur
        local dist = diff.Magnitude
        if dist <= stopDist then done = true result = true return end
        local moveAmt = math.min(dist, speed * dt)
        root.CFrame = CFrame.new(cur + diff.Unit * moveAmt) * root.CFrame.Rotation
    end)
    while not done do task.wait(0.05) end
    if tweenConn then tweenConn:Disconnect() tweenConn = nil end
    return result
end

local function safeFirePrompt(prompt)
    if not prompt or not prompt.Parent then return end
    pcall(fireproximityprompt, prompt)
end

local function findPromptInModel(model)
    for _,d in ipairs(model:GetDescendants()) do
        if d:IsA("ProximityPrompt") then return d end
    end
end

local function getChairPos(chair)
    local b = chair:FindFirstChild("Base")
    if b and b:IsA("BasePart") then return b.Position end
    local pp = chair.PrimaryPart
    if pp then return pp.Position end
    return chair:GetPivot().Position
end

local function getCartPrompt(chair)
    local att = chair:FindFirstChild("Attachment")
    if not att then return nil end
    local cp = att:FindFirstChild("CartPrompt")
    if cp and cp:IsA("ProximityPrompt") then return cp end
    return nil
end

local function getSeatPrompt(chair)
    local col = chair:FindFirstChild("Collider")
    if not col then return nil end
    local sp = col:FindFirstChild("SeatPrompt")
    if sp and sp:IsA("ProximityPrompt") then return sp end
    return nil
end

local function getGrabPosition(chair)
    local att = chair:FindFirstChild("Attachment")
    if att and att:IsA("Attachment") then
        local cf = att.WorldCFrame
        return cf.Position + cf.LookVector * (-2)
    end
    return getChairPos(chair)
end

local function lockChairParts(chair)
    for _,p in ipairs(chair:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = false
            p.CanTouch = false
            p.CanQuery = false
            p.Transparency = 1
            p.Massless = true
            p.CustomPhysicalProperties = PhysicalProperties.new(0,0,0,0,0)
        end
    end
end

local function disableChairPrompts(chair)
    for _,d in ipairs(chair:GetDescendants()) do
        if d:IsA("ProximityPrompt") then d.Enabled = false end
    end
end

local function enableAllPrompts()
    for c in pairs(allChairs) do
        if c and c.Parent then
            for _,d in ipairs(c:GetDescendants()) do
                if d:IsA("ProximityPrompt") then d.Enabled = true end
            end
        end
    end
end

local function stopAnchor()
    if anchorConn then anchorConn:Disconnect() anchorConn = nil end
    if reseatConn then reseatConn:Disconnect() reseatConn = nil end
    anticheatOn = false
    setHudOff()
    enableAllPrompts()
    activeChair = nil
end

local function doSeatCycle(seatPrompt)
    local char = getChar()
    if char then char:SetAttribute("SeatedInSeat", false) end
    task.wait(0.05)
    pcall(function() fireproximityprompt(seatPrompt) end)
    task.wait(0.05)
    char = getChar()
    if char then char:SetAttribute("SeatedInSeat", false) end
end

local function anchorToPlayer(chair, seatPrompt)
    if anchorConn then anchorConn:Disconnect() anchorConn = nil end
    if reseatConn then reseatConn:Disconnect() reseatConn = nil end
    activeChair = chair

    task.spawn(function()
        while activeChair == chair and not isCancelled() do
            pcall(function() cartControlRemote:FireServer() end)
            task.wait(0.05)
        end
    end)

    anchorConn = RunService.RenderStepped:Connect(function()
        if not chair or not chair.Parent then stopAnchor() return end
        local c = getChar()
        local root = c and c:FindFirstChild("HumanoidRootPart")
        if not root then return end

        chair:PivotTo(root.CFrame * CFrame.new(0,-2,0))

        if chair:GetAttribute("CartHitConnected") == true then
            chair:SetAttribute("CartHitConnected", false)
        end

        local seated = c:GetAttribute("SeatedInSeat")
        if seated == false then
            setHudOn()
            anticheatOn = true
        else
            setHudOff()
            anticheatOn = false
        end
        if seated == true then
            c:SetAttribute("SeatedInSeat", false)
        end
    end)

    reseatConn = RunService.Heartbeat:Connect(function()
        if not chair or not chair.Parent then return end
        if tostring(chair:GetAttribute("LastPusherId")) ~= playerUserId then return end
        local c = getChar()
        if not c then return end
        if c:GetAttribute("SeatedInSeat") == nil then
            task.spawn(function() doSeatCycle(seatPrompt) end)
        end
    end)
end

local function hookCharacter(character)
    character:GetAttributeChangedSignal("SeatedInSeat"):Connect(function()
        if activeChair and character:GetAttribute("SeatedInSeat") == true then
            character:SetAttribute("SeatedInSeat", false)
        end
    end)
end
