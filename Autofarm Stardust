scanFolder(currentRoomsFolder)

local function findNearestChair(exclude)
    local root = getRoot()
    if not root then return nil end
    local best = nil 
    local bestDist = math.huge
    local function check(d)
        if d.Name ~= "ArchivesOfficeChair" or not d:IsA("Model") then return end
        if exclude and d == exclude then return end
        local dist = (root.Position - getChairPos(d)).Magnitude
        if dist < bestDist then bestDist = dist best = d end
    end
    for _,d in ipairs(miscFolder:GetDescendants()) do check(d) end
    for i = 0, 50 do
        local rf = currentRoomsFolder:FindFirstChild(tostring(i))
        if rf then for _,d in ipairs(rf:GetDescendants()) do check(d) end end
    end
    return best
end

local function acquireFirstChair()
    if isCancelled() then return false end
    tweenToPos(WP1, SPEED_WALK, 1.5)
    if isCancelled() then return false end
    tweenToPos(WP2, SPEED_WALK, 1.5)
    if isCancelled() then return false end

    local chair = findNearestChair(nil)
    local ss = tick()
    while not chair do
        if isCancelled() then return false end
        if tick() - ss > CHAIR_SEARCH_LIMIT then return false end
        task.wait(0.3)
        chair = findNearestChair(nil)
    end

    local grabPos = getGrabPosition(chair)
    local root = getRoot()
    if root then
        root.CFrame = CFrame.new(grabPos) * root.CFrame.Rotation
    end
    task.wait(0.2)

    return grabAndBypass(chair)
end

local function switchChair()
    local ss = tick()
    local newChair = findNearestChair(activeChair)
    while not newChair do
        if isCancelled() then return false end
        if tick() - ss > CHAIR_SEARCH_LIMIT then break end
        task.wait(0.3)
        newChair = findNearestChair(activeChair)
    end
    if not newChair then return false end

    local cartPrompt = getCartPrompt(newChair)
    local seatPrompt = getSeatPrompt(newChair)
    if not cartPrompt or not seatPrompt then return false end

    local grabPos = getGrabPosition(newChair)
    tweenToPos(grabPos, SPEED_SWITCH, 1.5)
    if isCancelled() then return false end

    stopAnchor()
    pcall(function() cartControlRemote:FireServer() end)
    task.wait(0.15)

    local grabStart = tick()
    local owned = false
    while tick() - grabStart < 8 do
        if isCancelled() then return false end
        safeFirePrompt(cartPrompt)
        pcall(function() cartControlRemote:FireServer() end)
        task.wait(GRAB_INTERVAL)
        if tostring(newChair:GetAttribute("LastPusherId")) == playerUserId then
            owned = true break
        end
    end
    if not owned then return false end

    pcall(function() cartControlRemote:FireServer() end)
    task.wait(0.15)
    if isCancelled() then return false end

    lockChairParts(newChair)
    disableChairPrompts(newChair)
    doSeatCycle(seatPrompt)
    anchorToPlayer(newChair, seatPrompt)

    local ws = tick()
    local confirmed = false
    while tick() - ws < 5 do
        if isCancelled() then return false end
        local c = getChar()
        if c and c:GetAttribute("SeatedInSeat") == false then
            confirmed = true
            break
        end
        task.wait(0.1)
    end
    
    task.wait(1)
    return confirmed and anticheatOn
end

local function acquireAnyChair()
    if isCancelled() then return false end
    local ss = tick()
    local chair = findNearestChair(nil)
    local useNoclip = false
    while not chair do
        if isCancelled() then return false end
        if tick() - ss > CHAIR_SEARCH_LIMIT then useNoclip = true break end
        task.wait(0.3)
        chair = findNearestChair(nil)
    end
    if not chair then return false end
    
    local grabPos = getGrabPosition(chair)
    if useNoclip then
        tweenToPos(grabPos, SPEED_NOCLIP, 1.5)
    else
        tweenToPos(grabPos, SPEED_SWITCH, 1.5)
    end
    if isCancelled() then return false end
    
    return grabAndBypass(chair)
end

local function getRoomFolder(n) return currentRoomsFolder:FindFirstChild(tostring(n)) end

local function detectCurrentRoom()
    for i = 50, 0, -1 do if getRoomFolder(i) then return i end end return 0
end

local function waitForRoom(n, timeout)
    local s = tick()
    while tick() - s < timeout do
        if isCancelled() then return false end
        if getRoomFolder(n) then return true end
        task.wait(0.1)
    end
    return false
end

local function disableDoorCollision(door)
    for _,p in ipairs(door:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false end
    end
end

local function getDoorBasePart(door)
    local inner = door:FindFirstChild("Door")
    if inner and inner:IsA("BasePart") then return inner end
    local pp = door.PrimaryPart if pp then return pp end
    return door:FindFirstChildWhichIsA("BasePart")
end

local function openDoor(roomNum)
    if isCancelled() then return false end
    local rf = getRoomFolder(roomNum)
    if not rf then return false end
    local door = rf:FindFirstChild("Door")
    if not door then return false end
    disableDoorCollision(door)
    
    local doorPart = getDoorBasePart(door)
    local initialCF = doorPart and doorPart.CFrame
    local clientOpen = door:FindFirstChild("ClientOpen")
    if not clientOpen then return false end
    
    local nextRoom = roomNum + 1
    local speed = anticheatOn and SPEED_AC or SPEED_WALK

    if doorPart then
        tweenToPos(doorPart.Position, speed, 1.5)
        if isCancelled() then return false end
    end

    local opened = false
    local fs = tick()
    local pingDir = 1

    while tick() - fs < DOOR_TIMEOUT and not opened do
        if isCancelled() then return false end
        pcall(function() clientOpen:FireServer() end)
        task.wait(DOOR_FIRE_INTERVAL)

        if getRoomFolder(nextRoom) then opened = true break end

        if doorPart and initialCF then
            local ok, newCF = pcall(function() return doorPart.CFrame end)
            if ok then
                local pd = (newCF.Position - initialCF.Position).Magnitude
                local ax,ay,az = initialCF:ToEulerAnglesXYZ()
                local bx,by,bz = newCF:ToEulerAnglesXYZ()
                local rd = math.abs(math.deg(bx-ax))
                         + math.abs(math.deg(by-ay))
                         + math.abs(math.deg(bz-az))
                if rd > 5 or pd > 0.5 then opened = true break end
            end
        end

        if doorPart and (tick()-fs) % 0.5 < DOOR_FIRE_INTERVAL then
            local fwd = doorPart.CFrame.LookVector
            tweenToPos(doorPart.Position + fwd * (pingDir * 5), speed, 1.5)
            pingDir = -pingDir
            if isCancelled() then return false end
        end
    end

    if opened then waitForRoom(nextRoom + 1, 8) end
    return opened
end

local function lootMoveTo(pos)
    tweenToPos(pos, anticheatOn and SPEED_AC or SPEED_WALK, 1.5)
end

local function lootStardust(roomFolder)
    local seen = {} 
    local targets = {}
    for _,d in ipairs(roomFolder:GetDescendants()) do
        if (d.Name:find("Stardust") or d.Name:find("stardust")) and not seen[d] then
            seen[d] = true table.insert(targets, d)
        end
    end
    for _,target in ipairs(targets) do
        if isCancelled() then return end
        if not target.Parent then continue end
        local mainPart = (target:IsA("BasePart") and target)
            or target:FindFirstChild("Main")
            or target:FindFirstChildWhichIsA("BasePart")
        if mainPart and mainPart:IsA("BasePart") then lootMoveTo(mainPart.Position) end
        if isCancelled() then return end
        for _,d in ipairs(target:GetDescendants()) do
            if d:IsA("ProximityPrompt") then safeFirePrompt(d) end
        end
        if target:IsA("ProximityPrompt") then safeFirePrompt(target) end
        local ws = tick()
        while target.Parent and tick() - ws < 2 do task.wait(0.05) end
    end
end

local function lootDesks(roomFolder)
    local assets = roomFolder:FindFirstChild("Assets") or roomFolder
    for _,d in ipairs(assets:GetDescendants()) do
        if isCancelled() then return end
        if d:IsA("Model") and d.Name:match("^ArchivesDesk") then 
            local prompts = {}
            for _,child in ipairs(d:GetDescendants()) do
                if child.Name == "DrawerContainer" and child:IsA("Model") then
                    local knob = child:FindFirstChild("Knob")
                    if not knob then continue end
                    local prompt = knob:FindFirstChild("ActivateEventPrompt") or findPromptInModel(knob)
                    if not prompt then continue end
                    local endPart = child:FindFirstChild("End")
                    if endPart and endPart:IsA("BasePart") then
                        lootMoveTo((endPart.CFrame * CFrame.new(0,0,2)).Position)
                    end
                    table.insert(prompts, prompt)
                end
            end
            if isCancelled() then return end
            for _,p in ipairs(prompts) do 
                safeFirePrompt(p) 
                task.wait(0.2)
            end
            task.wait(0.2)
            lootStardust(roomFolder)
        end
    end
end

local function lootHidingSpots(roomFolder)
    local assets = roomFolder:FindFirstChild("Assets") or roomFolder
    local spots = {}
    for _,d in ipairs(assets:GetDescendants()) do
        if d:IsA("Model") and d.Name:match("^HidingSpot") then table.insert(spots, d) end
    end
    for _,spot in ipairs(spots) do
        if isCancelled() then return end
        if not spot.Parent then continue end
        local prompt = spot:FindFirstChild("InteractPrompt") or findPromptInModel(spot)
        if not prompt then continue end
        local pp = prompt.Parent
        if pp and pp:IsA("BasePart") then
            lootMoveTo((pp.CFrame * CFrame.new(0,0,-2)).Position)
        else
            lootMoveTo((spot:GetPivot() * CFrame.new(0,0,-2)).Position)
        end
        if isCancelled() then return end
        safeFirePrompt(prompt)
        task.wait(0.2)
        lootStardust(roomFolder)
    end
end

local function lootRoom(roomNum)
    if isCancelled() then return end
    local rf = getRoomFolder(roomNum)
    if not rf then return end
    lootStardust(rf)
    if isCancelled() then return end
    lootDesks(rf)
    if isCancelled() then return end
    lootHidingSpots(rf)
end

