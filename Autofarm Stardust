-- openDoor: moves around the door while firing ClientOpen rapidly
local function openDoor(roomNum)
    if isCancelled() then return false end
    local folderNum=roomNum-1
    local rf=getRoomFolder(folderNum)
    if not rf then warn("[DOOR] No folder",folderNum) return false end
    local door=rf:FindFirstChild("Door")
    if not door then warn("[DOOR] No Door in",folderNum) return false end
    disableDoorCollision(door)
    local doorPart=getDoorBasePart(door)
    local initialCF=doorPart and doorPart.CFrame
    local clientOpen=door:FindFirstChild("ClientOpen")
    if not clientOpen then warn("[DOOR] No ClientOpen") return false end

    local xzSpd=anticheatOn and SPEED_XZ or SPEED_WALK_XZ
    local ySpd=anticheatOn and SPEED_Y or SPEED_WALK_Y

    warn("[DOOR] Opening room",roomNum)

    -- Move to door first
    if doorPart then
        tweenToPos(doorPart.Position,xzSpd,ySpd,1.5)
        if isCancelled() then return false end
    end

    local opened=false
    local fs=tick()
    local pingDir=1
    local pingTimer=0
    local PING_INTERVAL=0.3

    while tick()-fs<DOOR_TIMEOUT and not opened do
        if isCancelled() then return false end

        -- Fire remote as fast as possible
        pcall(function() clientOpen:FireServer() end)
        task.wait(DOOR_FIRE_INTERVAL)

        if getRoomFolder(roomNum) then opened=true break end

        if doorPart and initialCF then
            local ok,newCF=pcall(function() return doorPart.CFrame end)
            if ok then
                local pd=(newCF.Position-initialCF.Position).Magnitude
                local ax,ay,az=initialCF:ToEulerAnglesXYZ()
                local bx,by,bz=newCF:ToEulerAnglesXYZ()
                local rd=math.abs(math.deg(bx-ax))+math.abs(math.deg(by-ay))+math.abs(math.deg(bz-az))
                if rd>5 or pd>0.5 then opened=true break end
            end
        end

        -- Ping-pong around door every PING_INTERVAL seconds to keep trigger active
        pingTimer=pingTimer+DOOR_FIRE_INTERVAL
        if doorPart and pingTimer>=PING_INTERVAL then
            pingTimer=0
            local fwd=doorPart.CFrame.LookVector
            local side=doorPart.CFrame.RightVector
            local offset=fwd*(pingDir*3)+side*(pingDir*2)
            tweenToPos(doorPart.Position+offset,xzSpd,ySpd,1.0)
            pingDir=-pingDir
            if isCancelled() then return false end
        end
    end

    if opened then
        warn("[DOOR] Opened room",roomNum)
        waitForRoom(roomNum+1,8)
    else
        warn("[DOOR] Timeout room",roomNum)
    end
    return opened
end

local function roomHasLootables(roomNum)
    local rf=getRoomFolder(roomNum) if not rf then return false end
    for _,d in ipairs(rf:GetDescendants()) do
        if d.Name:find("Stardust") or d.Name:find("stardust") then return true end
        if d:IsA("Model") and d.Name:match("^ArchivesDesk") then return true end
        if d:IsA("Model") and d.Name:match("^HidingSpot") then return true end
    end
    return false
end

