local previousMouseBehavior = Enum.MouseBehavior.Default

local function setUIVisible(visible)
	mainFrame.Visible = visible
	if not UserInputService.TouchEnabled then
		if visible then
			previousMouseBehavior = UserInputService.MouseBehavior
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		else
			UserInputService.MouseBehavior = previousMouseBehavior
		end
	end
end

local function cleanup()
	if cleanedUp then return end
	cleanedUp = true
	isRunning = false

	getgenv().AdvancedChairAdminLoaded = nil

	pcall(function()
		if not UserInputService.TouchEnabled then
			UserInputService.MouseBehavior = previousMouseBehavior
		end
	end)

	pcall(function() if viewportConn then viewportConn:Disconnect() end end)
	pcall(function() if descendantAddedConn then descendantAddedConn:Disconnect() end end)
	pcall(function() if descendantRemovingConn then descendantRemovingConn:Disconnect() end end)
	pcall(function() if playerAddedConn then playerAddedConn:Disconnect() end end)
	pcall(function() if playerRemovingConn then playerRemovingConn:Disconnect() end end)
	pcall(function() if inputBeganConn then inputBeganConn:Disconnect() end end)
	pcall(function() if dragInputGlobalConn then dragInputGlobalConn:Disconnect() end end)

	for _, chair in ipairs(knownChairs) do
		if chair and chair.Parent then
			pcall(function()
				chair:SetAttribute("LastPusherId", player.UserId)
				local esp = chair:FindFirstChild("BlueESP")
				if esp then esp:Destroy() end
				for _, part in ipairs(chair:GetDescendants()) do
					if part:IsA("BasePart") then
						part.Anchored = true
						part.CanCollide = true
						part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
						part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
					end
				end
			end)
		end
	end

	for _, p in ipairs(Players:GetPlayers()) do
		clearTargetVisuals(p)
	end
end

