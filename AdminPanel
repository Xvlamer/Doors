						part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
						part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
					end
				end
			end
		end
	else
		currentMode = "Throw"
		throwBtn.Text = "THROW (T): ON"
		throwBtn.BackgroundColor3 = Color3.fromRGB(35, 150, 80)
		jailBtn.Text = "JAIL (L): OFF"
		jailBtn.BackgroundColor3 = Color3.fromRGB(180, 115, 35)
		orbitBtn.Text = "ORBIT (O): OFF"
		orbitBtn.BackgroundColor3 = Color3.fromRGB(45, 105, 180)
