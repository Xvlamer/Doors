local function triggerJail()
	if currentMode == "Jail" then
		currentMode = "None"
		jailBtn.Text = "JAIL (L): OFF"
		jailBtn.BackgroundColor3 = Color3.fromRGB(180, 115, 35)
		jailPositions = {}
	else
		currentMode = "Jail"
		jailBtn.Text = "JAIL (L): ON"
		jailBtn.BackgroundColor3 = Color3.fromRGB(35, 150, 80)
		orbitBtn.Text = "ORBIT (O): OFF"
		orbitBtn.BackgroundColor3 = Color3.fromRGB(45, 105, 180)
		throwBtn.Text = "THROW (T): OFF"
		throwBtn.BackgroundColor3 = Color3.fromRGB(120, 40, 180)
		wallBtn.Text = "WALL (R): OFF"
		wallBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 180)
		wallPositions = {}
		orbitYLevels = {}
		
		jailPositions = {}
		local activeTargets = {}
		for p, _ in pairs(selectedTargets) do
			if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				table.insert(activeTargets, p)
			end
		end
		local numTargets = #activeTargets
		if numTargets > 0 and #collectedChairs > 0 then
			local chairsPerTarget = math.floor(#collectedChairs / numTargets)
			local remainder = #collectedChairs % numTargets
			local chairIndex = 1
			for tIdx, p in ipairs(activeTargets) do
				local tHrp = p.Character.HumanoidRootPart
				local tPos = tHrp.Position
				local countForThisTarget = chairsPerTarget + (tIdx <= remainder and 1 or 0)
				
				local roofCount = math.clamp(math.floor(countForThisTarget * 0.3), 3, 6)
				local wallCount = countForThisTarget - roofCount
				if wallCount < 4 then
					wallCount = countForThisTarget
					roofCount = 0
				end

				local assignedForTarget = {}
				for i = 1, countForThisTarget do
					if collectedChairs[chairIndex] then
						table.insert(assignedForTarget, collectedChairs[chairIndex])
						chairIndex = chairIndex + 1
					end
				end

				local cIdx = 1
				for i = 1, wallCount do
					local chair = assignedForTarget[cIdx]
					if chair then
						cIdx = cIdx + 1
						local angle = (i - 1) * (2 * math.pi / wallCount)
						local radius = 6.5
						local x = math.cos(angle) * radius
						local z = math.sin(angle) * radius
						local heightTier = (i % 2 == 0) and -1.8 or 1.2
						jailPositions[chair] = tPos + Vector3.new(x, heightTier, z)
					end
				end

				for i = 1, roofCount do
					local chair = assignedForTarget[cIdx]
					if chair then
						cIdx = cIdx + 1
						local r = (i == 1) and 0 or 3.5
						local angleRoof = (i == 1) and 0 or ((i - 2) * (2 * math.pi / (roofCount - 1)))
						local x = math.cos(angleRoof) * r
						local z = math.sin(angleRoof) * r
						jailPositions[chair] = tPos + Vector3.new(x, 4.2, z)
					end
				end
			end
		end
	end
end

