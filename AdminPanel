inputBeganConn = UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.LeftAlt or input.KeyCode == Enum.KeyCode.RightAlt then
		setUIVisible(not mainFrame.Visible)
	elseif input.KeyCode == Enum.KeyCode.K then triggerKill()
	elseif input.KeyCode == Enum.KeyCode.L then triggerJail()
	elseif input.KeyCode == Enum.KeyCode.O then triggerOrbit()
	elseif input.KeyCode == Enum.KeyCode.T then triggerThrow()
	elseif input.KeyCode == Enum.KeyCode.F then triggerFling()
	elseif input.KeyCode == Enum.KeyCode.R then triggerWall()
	end
end)

local function applyESP(chair)
	pcall(function()
		if not chair:FindFirstChild("BlueESP") then
			local h = Instance.new("Highlight"); h.Name = "BlueESP"
			h.FillColor = Color3.fromRGB(0,100,255); h.OutlineColor = Color3.fromRGB(100,180,255); h.Parent = chair
		end
	end)
end

local function removeESP(chair)
	pcall(function()
		local esp = chair:FindFirstChild("BlueESP"); if esp then esp:Destroy() end
	end)
end

local chairPartsCache = {}

local function cacheChairParts(chair)
	local parts = {}
	for _, part in ipairs(chair:GetDescendants()) do
		if part:IsA("BasePart") then
			table.insert(parts, part)
		end
	end
	chairPartsCache[chair] = parts
end

local function registerChair(obj)
	if obj.Name == TARGET_NAME and not table.find(knownChairs, obj) then
		table.insert(knownChairs, obj)
		task.defer(function() pcall(cacheChairParts, obj) end)
	end
end

descendantAddedConn = Workspace.DescendantAdded:Connect(function(obj)
	pcall(registerChair, obj)
end)
descendantRemovingConn = Workspace.DescendantRemoving:Connect(function(obj)
	local idx = table.find(knownChairs, obj)
	if idx then
		table.remove(knownChairs, idx)
		chairPartsCache[obj] = nil
	end
end)
for _, obj in ipairs(Workspace:GetDescendants()) do
	pcall(registerChair, obj)
end

local function pivotChair(chair, cf)
	if chair:IsA("Model") then
		chair:PivotTo(cf)
	elseif chair:IsA("BasePart") then
		chair.CFrame = cf
	end
end

local function applyPartsState(chair, canCollide, velocity)
	local parts = chairPartsCache[chair]
	if not parts then return end
	for _, part in ipairs(parts) do
		if part and part.Parent then
			part.Anchored   = false
			part.CanCollide = canCollide
			if velocity then
				part.AssemblyLinearVelocity  = velocity
				part.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end
end

local function applyPartsChaotic(chair, linVel, angVelRange)
	local parts = chairPartsCache[chair]
	if not parts then return end
	for _, part in ipairs(parts) do
		if part and part.Parent then
			part.Anchored   = false
			part.CanCollide = true
			part.AssemblyLinearVelocity  = linVel
			part.AssemblyAngularVelocity = Vector3.new(
				math.random(-angVelRange, angVelRange),
				math.random(-angVelRange, angVelRange),
				math.random(-angVelRange, angVelRange)
			)
		end
	end
end

RunService.Heartbeat:Connect(function()
	if not isRunning then return end

	local localChar = player.Character
	local rootPart  = localChar and localChar:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	local localHumanoid = localChar:FindFirstChildOfClass("Humanoid")
	local isLocalDead   = not localHumanoid or localHumanoid.Health <= 0

	if isLocalDead and not prevLocalDead then
		cachedDeadTarget = nil
		local others = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				table.insert(others, p)
			end
		end
		if #others > 0 then cachedDeadTarget = others[math.random(1, #others)] end
	elseif not isLocalDead and prevLocalDead then
		cachedDeadTarget = nil
	end
	prevLocalDead = isLocalDead

	local targetsChanged = false
	for p in pairs(selectedTargets) do
		local char     = p.Character
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")
		local hrp      = char and char:FindFirstChild("HumanoidRootPart")
		local remove   = not char or not humanoid or humanoid.Health <= 0 or not hrp
		if not remove and hrp then
			remove = (hrp.Position - rootPart.Position).Magnitude > 10000
		end
		if remove then
			selectedTargets[p] = nil
			clearTargetVisuals(p)
			targetsChanged = true
		else
			updateTargetVisuals(p)
		end
	end
	if targetsChanged then updatePlayerList(); refreshTitleTargetCount() end

	local miscFolder = Workspace:FindFirstChild("Misc")
	local remote     = ReplicatedStorage:FindFirstChild("RemotesFolder") and ReplicatedStorage.RemotesFolder:FindFirstChild("CartControl")
	local now        = tick()

	collectedChairs = {}
	local proximityQueue = {}

	for _, chair in ipairs(knownChairs) do
		if not chair or not chair.Parent then continue end

		local inMisc = miscFolder and chair:IsDescendantOf(miscFolder)

		if inMisc then
			table.insert(collectedChairs, chair)
			removeESP(chair)
			chair:SetAttribute("LastPromptTime", nil)
			if not chair:GetAttribute("ReleasedInMisc") then
				chair:SetAttribute("ReleasedInMisc", true)
				if remote then
					task.spawn(function() pcall(function() remote:FireServer() end) end)
				end
			end
		else
			chair:SetAttribute("ReleasedInMisc", nil)

			local esp = chair:FindFirstChild("BlueESP")
			if not esp then
				local h = Instance.new("Highlight")
				h.Name = "BlueESP"
				h.FillColor = Color3.fromRGB(0, 100, 255)
				h.OutlineColor = Color3.fromRGB(100, 180, 255)
				h.Parent = chair
			end

			local primary = (chair:IsA("Model") and (chair.PrimaryPart or chair:FindFirstChildWhichIsA("BasePart"))) or (chair:IsA("BasePart") and chair)
			if primary then
				local dist = (rootPart.Position - primary.Position).Magnitude
				if dist <= 25 then
					local prompt = chair:FindFirstChild("CartPrompt", true)
					if prompt then
						local lastFired = chair:GetAttribute("LastPromptTime") or 0
						if now - lastFired >= 0.1 then
							chair:SetAttribute("LastPromptTime", now)
							table.insert(proximityQueue, { chair = chair, prompt = prompt, dist = dist })
						end
					end
				end
			end
		end
	end

	status.Text = "Chairs Ready: " .. #collectedChairs

	table.sort(proximityQueue, function(a, b) return a.dist < b.dist end)
	for _, item in ipairs(proximityQueue) do
		pcall(function() fireproximityprompt(item.prompt) end)
		if remote then
			task.spawn(function() pcall(function() remote:FireServer() end) end)
		end
	end

	if currentMode == "Kill"  and now - (modeTimers["Kill"]  or 0) > 5 then allModesOff(); currentMode = "None" end
	if currentMode == "Fling" and now - (modeTimers["Fling"] or 0) > 1 then allModesOff(); currentMode = "None" end

	if #collectedChairs == 0 then return end

	local activeTargets = getActiveTargets()
	local numTargets    = #activeTargets
	local t             = tick()

	if currentMode == "Jail" then
		for _, chair in ipairs(collectedChairs) do
			if not chair or not chair.Parent then continue end
			local entry = jailFormation[chair]
			if entry then
				pivotChair(chair, entry.cf)
				if not chair:GetAttribute("JailPlaced") then
					chair:SetAttribute("JailPlaced", true)
					applyPartsState(chair, true, Vector3.zero)
				end
			else
				local fallback = rootPart.Position - Vector3.new(0, 30, 0)
				pivotChair(chair, CFrame.new(fallback))
				applyPartsState(chair, false, Vector3.zero)
			end
		end

	elseif currentMode == "Wall" then
		for _, chair in ipairs(collectedChairs) do
			if not chair or not chair.Parent then continue end
			local cf = wallFormation[chair]
			if cf then
				pivotChair(chair, cf)
				if not chair:GetAttribute("WallPlaced") then
					chair:SetAttribute("WallPlaced", true)
					applyPartsState(chair, true, Vector3.zero)
				end
			end
		end

	elseif currentMode == "Orbit" then
		if numTargets == 0 then
			local total = #collectedChairs
			local radius, spinSpeed = 12, 4
			for i, chair in ipairs(collectedChairs) do
				if not chair or not chair.Parent then continue end
				local angle = ((i-1) * (2*math.pi / total)) + t * spinSpeed
				local pos   = Vector3.new(rootPart.Position.X + math.cos(angle)*radius, localOrbitY, rootPart.Position.Z + math.sin(angle)*radius)
				pivotChair(chair, CFrame.new(pos))
				applyPartsState(chair, false, Vector3.zero)
			end
		else
			local perTarget = math.floor(#collectedChairs / numTargets)
			local rem       = #collectedChairs % numTargets
			local cIdx      = 1
			for tIdx, p in ipairs(activeTargets) do
				local hrp   = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
				if not hrp then cIdx += perTarget + (tIdx <= rem and 1 or 0); continue end
				local count = perTarget + (tIdx <= rem and 1 or 0)
				local locY  = orbitYLevels[p] or hrp.Position.Y
				local radius, spinSpeed = 12, 4
				for localIdx = 1, count do
					local chair = collectedChairs[cIdx]; cIdx += 1
					if not chair or not chair.Parent then continue end
					local angle = ((localIdx-1) * (2*math.pi / math.max(count,1))) + t * spinSpeed
					local pos   = Vector3.new(hrp.Position.X + math.cos(angle)*radius, locY, hrp.Position.Z + math.sin(angle)*radius)
					pivotChair(chair, CFrame.new(pos))
					applyPartsState(chair, false, Vector3.zero)
				end
			end
		end

	elseif currentMode == "Throw" then
		for i, chair in ipairs(collectedChairs) do
			if not chair or not chair.Parent then continue end
			local primary = (chair:IsA("Model") and (chair.PrimaryPart or chair:FindFirstChildWhichIsA("BasePart"))) or (chair:IsA("BasePart") and chair)
			if not primary then continue end

			local dist = (primary.Position - rootPart.Position).Magnitude
			if dist > 500 then
				chair:SetAttribute("IsThrown", nil)
				pivotChair(chair, CFrame.new(rootPart.Position - Vector3.new(0, 30, (i%5)*2)))
				applyPartsState(chair, false, Vector3.zero)
			elseif not chair:GetAttribute("IsThrown") then
				chair:SetAttribute("IsThrown", true)
				local groundY = rootPart.Position.Y - 2.5
				local front   = Vector3.new(
					rootPart.Position.X + rootPart.CFrame.LookVector.X * 15,
					groundY,
					rootPart.Position.Z + rootPart.CFrame.LookVector.Z * 15
				)
				local stagger = Vector3.new(0, i * 0.15, 0)
				pivotChair(chair, CFrame.new(front + stagger))
				task.delay(0.05, function()
					if chair and chair.Parent then
						local lookDir = rootPart.CFrame.LookVector
						applyPartsChaotic(chair,
							(lookDir * 250) + Vector3.new(0, math.random(20, 45), 0),
							400
						)
					end
				end)
			end
		end

	elseif currentMode == "Fling" and numTargets > 0 then
		local elapsed = t - (modeTimers["Fling"] or t)
		local cIdx = 1
		for _, p in ipairs(activeTargets) do
			local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if not hrp then continue end
			local count = math.min(#collectedChairs - cIdx + 1, math.ceil(#collectedChairs / numTargets))
			for localIdx = 1, count do
				local chair = collectedChairs[cIdx]; cIdx += 1
				if not chair or not chair.Parent then continue end
				if elapsed < 0.12 then
					local angle  = (localIdx - 1) * (2 * math.pi / math.max(count, 1))
					local spiral = elapsed * 8
					local rx     = math.cos(angle + spiral) * (0.3 + elapsed * 4)
					local rz     = math.sin(angle + spiral) * (0.3 + elapsed * 4)
					pivotChair(chair, CFrame.new(hrp.Position + Vector3.new(rx, -1 + localIdx * 0.2, rz)))
					for _, part in ipairs(chair:GetDescendants()) do
						if part:IsA("BasePart") then
							part.Anchored    = false
							part.CanCollide  = true
							part.AssemblyAngularVelocity = Vector3.new(
								math.random(-999, 999),
								math.random(-999, 999),
								math.random(-999, 999)
							)
						end
					end
				elseif elapsed < 0.13 then
					for _, part in ipairs(chair:GetDescendants()) do
						if part:IsA("BasePart") then
							part.Anchored   = false
							part.CanCollide = true
							part.AssemblyLinearVelocity  = Vector3.new(
								math.random(-120, 120),
								math.random(280, 480),
								math.random(-120, 120)
							)
							part.AssemblyAngularVelocity = Vector3.new(
								math.random(-9999, 9999),
								math.random(-9999, 9999),
								math.random(-9999, 9999)
							)
						end
					end
				end
			end
		end

	elseif currentMode == "Kill" and numTargets > 0 then
		local perTarget = math.floor(#collectedChairs / numTargets)
		local rem       = #collectedChairs % numTargets
		local cIdx      = 1
		for tIdx, p in ipairs(activeTargets) do
			local hrp   = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if not hrp then cIdx += perTarget + (tIdx <= rem and 1 or 0); continue end
			local count = perTarget + (tIdx <= rem and 1 or 0)
			for localIdx = 1, count do
				local chair = collectedChairs[cIdx]; cIdx += 1
				if not chair or not chair.Parent then continue end
				local radius = 3.5 + math.sin(t * 15 + localIdx) * 1.5
				local angle  = t * 35 + localIdx * 1.5
				local x      = math.cos(angle) * radius
				local z      = math.sin(angle) * radius
				local yOff   = math.sin(t * 25 + localIdx) * 3 + 2.5
				pivotChair(chair, CFrame.new(hrp.Position + Vector3.new(x, yOff, z)))
				applyPartsChaotic(chair,
					Vector3.new(math.random(-400, 400), math.random(200, 500), math.random(-400, 400)),
					99999
				)
			end
		end

	else
		local fallbackPos
		if isLocalDead and cachedDeadTarget and cachedDeadTarget.Character and cachedDeadTarget.Character:FindFirstChild("HumanoidRootPart") then
			fallbackPos = cachedDeadTarget.Character.HumanoidRootPart.Position
		else
			fallbackPos = rootPart.Position
		end
		for i, chair in ipairs(collectedChairs) do
			if not chair or not chair.Parent then continue end
			pivotChair(chair, CFrame.new(fallbackPos - Vector3.new(0, 30, (i%5)*2)))
			applyPartsState(chair, false, Vector3.zero)
		end
	end
end)
