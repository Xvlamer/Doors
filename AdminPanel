local function updatePlayerList()
	pcall(function()
		for _, child in ipairs(scroll:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				local btn = Instance.new("TextButton")
				btn.Size = UDim2.new(1, 0, 0, 30)
				btn.BackgroundColor3 = selectedTargets[p] and Color3.fromRGB(50, 50, 80) or Color3.fromRGB(22, 22, 32)
				btn.Text = p.DisplayName .. " (@" .. p.Name .. ")"
				btn.TextColor3 = Color3.fromRGB(210, 210, 220)
				btn.TextSize = 11
				btn.Font = Enum.Font.Gotham
				btn.Parent = scroll

				local bCorner = Instance.new("UICorner")
				bCorner.CornerRadius = UDim.new(0, 6)
				bCorner.Parent = btn

				btn.MouseButton1Click:Connect(function()
					if selectedTargets[p] then
						selectedTargets[p] = nil
						btn.BackgroundColor3 = Color3.fromRGB(22, 22, 32)
						clearTargetVisuals(p)
					else
						selectedTargets[p] = true
						btn.BackgroundColor3 = Color3.fromRGB(50, 50, 80)
						updateTargetVisuals(p)
					end
					
					local count = 0
					for _ in pairs(selectedTargets) do count = count + 1 end
					if count == 0 then
						title.Text = "Chair Admin Panel"
					else
						title.Text = "Targets: " .. count
					end
				end)
			end
		end
		scroll.CanvasSize = UDim2.new(0, 0, 0, scrollLayout.AbsoluteContentSize.Y + 8)
	end)
end

