local function triggerWall()
	if currentMode == "Wall" then
		currentMode = "None"
		wallBtn.Text = "WALL (R): OFF"
		wallBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 180)
		wallPositions = {}
	else
		currentMode = "Wall"
		wallBtn.Text = "WALL (R): ON"
		wallBtn.BackgroundColor3 = Color3.fromRGB(35, 150, 80)
		jailBtn.Text = "JAIL (L): OFF"
		jailBtn.BackgroundColor3 = Color3.fromRGB(180, 115, 35)
		orbitBtn.Text = "ORBIT (O): OFF"
		orbitBtn.BackgroundColor3 = Color3.fromRGB(45, 105, 180)
		throwBtn.Text = "THROW (T): OFF"
		throwBtn.BackgroundColor3 = Color3.fromRGB(120, 40, 180)
		jailPositions = {}
		wallPositions = {}
		orbitYLevels = {}

		local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if rootPart and #collectedChairs > 0 then
			local totalChairs = #collectedChairs
			local maxRows = 5
			local maxPerRow = math.ceil(totalChairs / maxRows)
			if maxPerRow < 1 then maxPerRow = 1 end
			
			local rightVec = rootPart.CFrame.RightVector
			local lookVec = rootPart.CFrame.LookVector
			local centerPos = rootPart.Position + (lookVec * 15) + Vector3.new(0, -3.0, 0)
			local spacingX = 3.2
			local spacingY = 3.2

			for i, chair in ipairs(collectedChairs) do
				local row = math.floor((i - 1) / maxPerRow)
				local col = (i - 1) % maxPerRow
				local currentCharsInThisRow = math.min(totalChairs - row * maxPerRow, maxPerRow)
				
				local xOffset = (col - (currentCharsInThisRow - 1) / 2) * spacingX
				local yOffset = row * spacingY
				local targetPos = centerPos + (rightVec * xOffset) + Vector3.new(0, yOffset, 0)
				
				-- Uses the exact same clean position-based locking method as Jail, turned around 180 degrees
				wallPositions[chair] = CFrame.new(targetPos) * CFrame.Angles(0, math.rad(180), 0)
			end
		end
	end
end

