jailBtn.MouseButton1Click:Connect(triggerJail)
orbitBtn.MouseButton1Click:Connect(triggerOrbit)
throwBtn.MouseButton1Click:Connect(triggerThrow)
flingBtn.MouseButton1Click:Connect(triggerFling)
