local function getActiveTargets()
	local out = {}
	for p in pairs(selectedTargets) do
		if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			table.insert(out, p)
		end
	end
	return out
end

local function buildJailFormation()
	jailFormation = {}
	local activeTargets = getActiveTargets()
	local numTargets    = #activeTargets
	if numTargets == 0 or #collectedChairs == 0 then return end

	local chairsPerTarget = math.floor(#collectedChairs / numTargets)
	local remainder       = #collectedChairs % numTargets
	local chairIndex      = 1

	for tIdx, p in ipairs(activeTargets) do
		local tHrp = p.Character.HumanoidRootPart
		local tPos = tHrp.Position
		local countForTarget = chairsPerTarget + (tIdx <= remainder and 1 or 0)

		local assigned = {}
		for i = 1, countForTarget do
			if collectedChairs[chairIndex] then
				table.insert(assigned, collectedChairs[chairIndex])
				chairIndex += 1
			end
		end

		local pairCount = math.floor(#assigned / 2)
		if pairCount < 1 then pairCount = 1 end

		local baseRadius = math.max(3.5, pairCount * 0.55)
		local outerRadius = baseRadius + 1

		for i = 1, pairCount do
			local angle = (i - 1) * (2 * math.pi / pairCount)
			local dx    = math.cos(angle)
			local dz    = math.sin(angle)

			local groundY    = tPos.Y - 3
			local innerPos = Vector3.new(tPos.X + dx * baseRadius,  groundY, tPos.Z + dz * baseRadius)
			local outerPos = Vector3.new(tPos.X + dx * outerRadius, groundY, tPos.Z + dz * outerRadius)

			local faceInYaw  = math.atan2(dx, dz)
			local faceOutYaw = math.atan2(-dx, -dz)

			local innerChair = assigned[i]
			local outerChair = assigned[i + pairCount]

			if innerChair then
				jailFormation[innerChair] = {
					pos = innerPos,
					cf  = CFrame.new(innerPos) * CFrame.Angles(0, faceInYaw, 0)
				}
			end
			if outerChair then
				jailFormation[outerChair] = {
					pos = outerPos,
					cf  = CFrame.new(outerPos) * CFrame.Angles(0, faceOutYaw, 0)
				}
			end
		end
	end
end

local function buildWallFormation()
	wallFormation = {}
	local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not rootPart or #collectedChairs == 0 then return end

	local total    = #collectedChairs
	local rightVec = rootPart.CFrame.RightVector
	local lookVec  = rootPart.CFrame.LookVector
	local spacingX = 2.6
	local spacingY = 2.8
	local maxRows  = 3

	local rawYaw   = math.atan2(lookVec.X, lookVec.Z)
	local snapped  = math.round(rawYaw / (math.pi / 2)) * (math.pi / 2)
	local seatAngle = snapped

	local layerDists = { 25, 27 }
	local layerSplit = math.floor(total / 2)

	local layers = {
		{ chairs = {}, dist = 25 },
		{ chairs = {}, dist = 27 },
	}
	for i, chair in ipairs(collectedChairs) do
		if i <= layerSplit then
			table.insert(layers[1].chairs, chair)
		else
			table.insert(layers[2].chairs, chair)
		end
	end

	for _, layer in ipairs(layers) do
		local lTotal    = #layer.chairs
		local maxPerRow = math.max(math.ceil(lTotal / maxRows), 1)
		local centerPos = rootPart.Position + lookVec * layer.dist + Vector3.new(0, -3, 0)
		for i, chair in ipairs(layer.chairs) do
			local row      = math.floor((i-1) / maxPerRow)
			local col      = (i-1) % maxPerRow
			local rowCount = math.min(lTotal - row * maxPerRow, maxPerRow)
			local xOffset  = (col - (rowCount - 1) / 2) * spacingX
			local yOffset  = row * spacingY
			local targetPos = centerPos + rightVec * xOffset + Vector3.new(0, yOffset, 0)
			wallFormation[chair] = CFrame.new(targetPos) * CFrame.Angles(0, seatAngle, 0)
		end
	end
end

local function enterMode(mode)
	allModesOff()
	currentMode = mode
	modeTimers[mode] = tick()
end

local function leaveMode(mode)
	if currentMode == mode then
		allModesOff()
		currentMode = "None"
	end
end

local function triggerKill()
	enterMode("Kill")
end

local function triggerJail()
	if currentMode == "Jail" then
		leaveMode("Jail")
	else
		enterMode("Jail")
		jailBtn.Text = "JAIL (L): ON"; jailBtn.BackgroundColor3 = ON_GREEN
		buildJailFormation()
	end
end

local function triggerOrbit()
	if currentMode == "Orbit" then
		leaveMode("Orbit")
	else
		enterMode("Orbit")
		orbitBtn.Text = "ORBIT (O): ON"; orbitBtn.BackgroundColor3 = ON_GREEN
		local rootP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if rootP then localOrbitY = rootP.Position.Y end
		orbitYLevels = {}
		for p in pairs(selectedTargets) do
			local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if hrp then orbitYLevels[p] = hrp.Position.Y end
		end
	end
end

local function triggerThrow()
	if currentMode == "Throw" then
		leaveMode("Throw")
		for _, chair in ipairs(collectedChairs) do
			if chair and chair.Parent then
				chair:SetAttribute("IsThrown", nil)
				for _, part in ipairs(chair:GetDescendants()) do
					if part:IsA("BasePart") then
						part.AssemblyLinearVelocity  = Vector3.zero
						part.AssemblyAngularVelocity = Vector3.zero
					end
				end
			end
		end
	else
		enterMode("Throw")
		throwBtn.Text = "THROW (T): ON"; throwBtn.BackgroundColor3 = ON_GREEN
		for _, chair in ipairs(collectedChairs) do
			if chair and chair.Parent then chair:SetAttribute("IsThrown", nil) end
		end
	end
end

local function triggerFling()
	enterMode("Fling")
end

local function triggerWall()
	if currentMode == "Wall" then
		leaveMode("Wall")
	else
		enterMode("Wall")
		wallBtn.Text = "WALL (R): ON"; wallBtn.BackgroundColor3 = ON_GREEN
		buildWallFormation()
	end
end

