local function clearTargetVisuals(p)
	pcall(function()
		local d = targetVisualData[p]
		if not d then return end
		if d.tag and d.tag.Parent     then d.tag:Destroy()       end
		if d.highlight and d.highlight.Parent then d.highlight:Destroy() end
		targetVisualData[p] = nil
	end)
end

local function updateTargetVisuals(p)
	pcall(function()
		if not selectedTargets[p] then clearTargetVisuals(p); return end
		local char = p.Character
		if not char or not char:FindFirstChild("Head") or not char:FindFirstChild("HumanoidRootPart") then
			clearTargetVisuals(p); return
		end
		if not targetVisualData[p] then
			targetVisualData[p] = {}
			local bg    = Instance.new("BillboardGui")
			bg.Name     = "TargetInfoTag"; bg.Size = UDim2.new(0,160,0,50)
			bg.StudsOffset = Vector3.new(0,2.8,0); bg.AlwaysOnTop = true; bg.Parent = char.Head
			local lbl   = Instance.new("TextLabel")
			lbl.Name    = "InfoLabel"; lbl.Size = UDim2.new(1,0,1,0)
			lbl.BackgroundTransparency = 1; lbl.TextColor3 = Color3.fromRGB(255,255,255)
			lbl.TextStrokeTransparency = 0; lbl.TextStrokeColor3 = Color3.fromRGB(0,0,0)
			lbl.TextSize = 13; lbl.Font = Enum.Font.GothamBold; lbl.TextWrapped = true; lbl.Parent = bg
			targetVisualData[p].tag   = bg
			targetVisualData[p].label = lbl
			local hl = Instance.new("Highlight")
			hl.Name             = "TargetESP"; hl.Adornee = char
			hl.FillColor        = Color3.fromRGB(15,15,20); hl.FillTransparency = 0.5
			hl.OutlineColor     = Color3.fromRGB(255,255,255); hl.OutlineTransparency = 0.5
			hl.Parent           = char
			targetVisualData[p].highlight = hl
		end
		local lbl    = targetVisualData[p].label
		local lHrp   = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local hrp    = char:FindFirstChild("HumanoidRootPart")
		if lbl and lHrp and hrp then
			local dist = math.floor((lHrp.Position - hrp.Position).Magnitude + 0.5)
			lbl.Text = "@" .. p.Name .. "\n" .. dist .. " studs"
		end
	end)
end

