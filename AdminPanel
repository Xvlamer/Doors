		currentMode = "None"
		throwBtn.Text = "THROW (T): OFF"
		throwBtn.BackgroundColor3 = Color3.fromRGB(120, 40, 180)
		for _, chair in ipairs(collectedChairs) do
			if chair and chair.Parent then
				chair:SetAttribute("IsThrown", nil)
				for _, part in ipairs(chair:GetDescendants()) do
