local function cleanup()
	if cleanedUp then return end
	cleanedUp = true
	isRunning = false
	getgenv().AdvancedChairAdminLoaded = nil

	pcall(function()
		if not UserInputService.TouchEnabled then UserInputService.MouseBehavior = prevMouseBehavior end
	end)
	for _, conn in ipairs({ viewportConn, descendantAddedConn, descendantRemovingConn, playerAddedConn, playerRemovingConn, inputBeganConn, dragInputGlobalConn }) do
		pcall(function() if conn then conn:Disconnect() end end)
	end
	for _, chair in ipairs(knownChairs) do
		pcall(function()
			if chair and chair.Parent then
				local esp = chair:FindFirstChild("BlueESP"); if esp then esp:Destroy() end
				chair:SetAttribute("ReleasedInMisc", nil)
				chair:SetAttribute("LastPromptTime", nil)
				chair:SetAttribute("IsThrown", nil)
				for _, part in ipairs(chair:GetDescendants()) do
					if part:IsA("BasePart") then part.Anchored = false end
				end
			end
		end)
	end
	for _, p in ipairs(Players:GetPlayers()) do clearTargetVisuals(p) end
end

