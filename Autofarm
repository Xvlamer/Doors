-- Token: getgenv().XvlamerHub_DailyRunActive (bool)
-- Set true to start, set false to abort at any point.

-- findDoorTarget:
-- Targets the EXACT structure visible in the explorer screenshot:
--   CurrentRooms > 0 > Door (Model) > Door (BasePart)
-- That inner "Door" BasePart is the highlighted mesh the player must reach.
-- Falls back through progressively wider searches if the exact path isn't found,
-- but NEVER returns a position from a part named "Door" that lives at the wrong
-- depth (e.g. BlockedDoorModel children, Sign children, etc.).
local function findDoorTarget()
    local currentRooms = workspace:FindFirstChild("CurrentRooms")
    if not currentRooms then return nil end

    -- Prefer room "0"; fall back to numerically lowest child
    local room0 = currentRooms:FindFirstChild("0")
    if not room0 then
        local children = currentRooms:GetChildren()
        table.sort(children, function(a, b)
            return (tonumber(a.Name) or 999) < (tonumber(b.Name) or 999)
        end)
        room0 = children[1]
    end
    if not room0 then return nil end

    -- ── Pass 1: Exact path  CurrentRooms/0/Door (Model) > Door (BasePart) ──────
    -- This matches the explorer exactly: room0 > Model named "Door" > Part named "Door"
    local doorModel = room0:FindFirstChild("Door")
    if doorModel and doorModel:IsA("Model") then
        local innerPart = doorModel:FindFirstChild("Door")
        if innerPart and innerPart:IsA("BasePart") then
            return innerPart.Position
        end
        -- Inner part might be named differently — try PrimaryPart or first BasePart
        -- that is NOT a blocker/collision stand-in
        local primary = doorModel.PrimaryPart
        if primary and primary:IsA("BasePart") then
            return primary.Position
        end
        for _, v in ipairs(doorModel:GetChildren()) do
            if v:IsA("BasePart")
                and v.Name ~= "Collision"
                and v.Name ~= "Hidden"
                and v.Name ~= "Sign" then
                return v.Position
            end
        end
    end

    -- ── Pass 2: Any Model named "Door" anywhere in room0 (one level deeper) ────
    for _, child in ipairs(room0:GetChildren()) do
        if child:IsA("Model") and child.Name == "Door" then
            local inner = child:FindFirstChild("Door")
            if inner and inner:IsA("BasePart") then return inner.Position end
            local pp = child.PrimaryPart or child:FindFirstChildOfClass("BasePart")
            if pp then return pp.Position end
        end
    end

    -- ── Pass 3: Deepest BasePart named "Door" that is a descendant of a Model
    --           named "Door" — handles nested grouping ─────────────────────────
    for _, v in ipairs(room0:GetDescendants()) do
        if v:IsA("BasePart") and v.Name == "Door" then
            local ancestor = v.Parent
            while ancestor and ancestor ~= room0 do
                if ancestor.Name == "Door" and ancestor:IsA("Model") then
                    return v.Position
                end
                ancestor = ancestor.Parent
            end
        end
    end

    -- ── Pass 4: Any BasePart named "Door" in room0, excluding obvious non-doors ─
    for _, v in ipairs(room0:GetDescendants()) do
        if v:IsA("BasePart") and v.Name == "Door"
            and v.Parent
            and v.Parent.Name ~= "Collision"
            and v.Parent.Name ~= "Sign" then
            return v.Position
        end
    end

    -- ── Pass 5: RoomExit / RoomEntrance as absolute last resort ─────────────────
    local exitPart = room0:FindFirstChild("RoomExit")
        or room0:FindFirstChild("RoomEntrance")
    if exitPart and exitPart:IsA("BasePart") then
        return exitPart.Position
    end

    return nil
end

-- tweenToPosition:
-- Steps the HumanoidRootPart CFrame every Heartbeat at 15 studs/s toward targetPos.
-- Y is locked to the root's current Y so the player stays on the floor.
-- hDist uses plain Vector3 magnitude on a flattened vector — no Vector2.Distance
-- (which doesn't exist in Roblox Luau and was causing the spam crash).
-- CFrame rotation is preserved with CFrame.new(pos) * cf.Rotation which is valid.
-- WalkSpeed set to 0 for the duration so physics doesn't fight the writes.
local function tweenToPosition(targetPos, stopToken)
    local SPEED      = 15  -- studs per second
    local ARRIVE_XZ  = 2.0 -- XZ distance threshold for arrival

    local function getChar()
        local c = P.Character
        if not c then return nil, nil end
        local root = c:FindFirstChild("HumanoidRootPart")
        local hum  = c:FindFirstChildOfClass("Humanoid")
        return root, hum
    end

    -- XZ flat distance — plain magnitude, no Vector2
    local function hDist(a, b)
        local dx = a.X - b.X
        local dz = a.Z - b.Z
        return math.sqrt(dx*dx + dz*dz)
    end

    local root, hum = getChar()
    if not root then return false end

    local prevWalk   = hum and hum.WalkSpeed  or 16
    local prevJumpH  = hum and hum.JumpHeight or 7.2
    local prevJumpP  = hum and hum.JumpPower  or 50

    if hum then
        hum.WalkSpeed  = 0
        hum.JumpHeight = 0
        hum.JumpPower  = 0
    end

    local done   = false
    local result = false

    local conn = RS.Heartbeat:Connect(function(dt)
        if done then return end
        if getgenv().XvlamerHub_Cancelled or stopToken() then
            done = true; result = false; return
        end

        root, hum = getChar()
        if not root then done = true; result = false; return end

        -- Keep humanoid frozen every frame
        if hum then
            hum.WalkSpeed  = 0
            hum.JumpHeight = 0
            hum.JumpPower  = 0
        end

        local curPos = root.Position
        local curCF  = root.CFrame

        -- Flat target — keep Y at player's current height
        local flatTarget = Vector3.new(targetPos.X, curPos.Y, targetPos.Z)
        local dist = hDist(curPos, targetPos)

        if dist <= ARRIVE_XZ then
            done = true; result = true; return
        end

        local dir = flatTarget - curPos
        if dir.Magnitude < 0.001 then done = true; result = true; return end

        local step    = math.min(dir.Magnitude, SPEED * dt)
        local newPos  = curPos + dir.Unit * step

        -- CFrame.new(pos) * cf.Rotation: valid Roblox Luau — preserves look direction
        root.CFrame = CFrame.new(newPos) * curCF.Rotation
    end)

    while not done do task.wait(0.05) end

    pcall(function() conn:Disconnect() end)

    root, hum = getChar()
    if hum then
        hum.WalkSpeed  = prevWalk
        hum.JumpHeight = prevJumpH
        hum.JumpPower  = prevJumpP
    end

    return result
end

-- getDoorPart:
-- Returns the actual BasePart from the Door model so we can monitor its CFrame.
local function getDoorPart()
    local ok, part = pcall(function()
        local room0 = workspace:WaitForChild("CurrentRooms", 5):WaitForChild("0", 5)
        local doorModel = room0:WaitForChild("Door", 5)
        -- The inner BasePart named "Door" is the one that rotates when opened
        local inner = doorModel:FindFirstChild("Door")
        if inner and inner:IsA("BasePart") then return inner end
        -- Fallback to any non-collision BasePart in the model
        for _, v in ipairs(doorModel:GetDescendants()) do
            if v:IsA("BasePart") and v.Name ~= "Collision" and v.Name ~= "Hidden" then
                return v
            end
        end
        return doorModel:FindFirstChildOfClass("BasePart")
    end)
    return ok and part or nil
end

-- waitForDoorOpen:
-- Waits until the door's CFrame/rotation actually changes by a meaningful amount
-- AND the ClientOpen remote has been fired at least once.
-- Returns true when both conditions are met, false on timeout or abort.
local function waitForDoorOpen(clientOpenFired, stopToken)
    local ROTATION_THRESHOLD = 5   -- degrees — any rotation > this = door moving
    local TIMEOUT            = 30  -- seconds max to wait

    local doorPart = getDoorPart()
    if not doorPart then return false end

    local initialCF    = doorPart.CFrame
    local initialAngles = Vector3.new(initialCF:ToEulerAnglesXYZ())
    local deadline     = tick() + TIMEOUT

    while tick() < deadline do
        if getgenv().XvlamerHub_Cancelled or stopToken() then return false end

        -- Check clientOpen was fired
        if not clientOpenFired() then
            task.wait(0.05)
            continue
        end

        -- Check door has actually moved
        local ok, cf = pcall(function() return doorPart.CFrame end)
        if not ok then task.wait(0.05); continue end

        local curAngles = Vector3.new(cf:ToEulerAnglesXYZ())
        local dx = math.abs(math.deg(curAngles.X - initialAngles.X))
        local dy = math.abs(math.deg(curAngles.Y - initialAngles.Y))
        local dz = math.abs(math.deg(curAngles.Z - initialAngles.Z))

        -- Also check positional shift in case it slides rather than rotates
        local posDelta = (cf.Position - initialCF.Position).Magnitude

        if dx > ROTATION_THRESHOLD or dy > ROTATION_THRESHOLD or dz > ROTATION_THRESHOLD
            or posDelta > 0.5 then
            return true
        end

        task.wait(0.05)
    end

    return false
end

local function runDailyCompletion()
    -- Phase 1: Wait for Ripple/Daily floor confirmed loaded
    local waitDeadline = tick() + 90
    while not isOnDailyFloor() do
        if getgenv().XvlamerHub_Cancelled or not getgenv().XvlamerHub_DailyRunActive then return end
        if tick() > waitDeadline then return end
        task.wait(0.5)
    end

    -- Settle: let room geometry fully replicate
    task.wait(3)

    if getgenv().XvlamerHub_Cancelled or not getgenv().XvlamerHub_DailyRunActive then return end

    -- Wait for character to be alive
    local charWait = tick() + 20
    while true do
        if getgenv().XvlamerHub_Cancelled or not getgenv().XvlamerHub_DailyRunActive then return end
        if tick() > charWait then return end
        local c = P.Character
        if c then
            local h = c:FindFirstChildOfClass("Humanoid")
            local r = c:FindFirstChild("HumanoidRootPart")
            if h and r and h.Health > 0 then break end
        end
        task.wait(0.2)
    end

    local stopToken = function()
        return not getgenv().XvlamerHub_DailyRunActive
    end

    -- Phase 2: Locate door position
    local targetPos = nil
    local searchDeadline = tick() + 20
    while not targetPos do
        if getgenv().XvlamerHub_Cancelled or stopToken() then return end
        if tick() > searchDeadline then
            getgenv().XvlamerHub_DailyRunActive = false
            return
        end
        targetPos = findDoorTarget()
        if not targetPos then task.wait(0.5) end
    end

    if getgenv().XvlamerHub_Cancelled or stopToken() then return end

    -- Phase 3: Tween the player to the door at 15 studs/s.
    -- CFrame-stepped every Heartbeat. No pathfinding, no stuck states.
    -- Arrival = XZ distance ≤ 2 studs.
    local reached = tweenToPosition(targetPos, stopToken)

    if getgenv().XvlamerHub_Cancelled or stopToken() then
        getgenv().XvlamerHub_DailyRunActive = false
        return
    end

    if not reached then
        getgenv().XvlamerHub_DailyRunActive = false
        return
    end

    -- Phase 4: Fire ClientOpen every 0.1s AND wait for the door to physically open.
    -- clientOpenFired tracks whether at least one successful FireServer call landed.
    -- waitForDoorOpen watches the door BasePart's CFrame for rotation/position change.
    -- Kill and leave fire ONLY after both conditions are confirmed.
    local clientOpenFired_flag = false
    local clientOpenFired = function() return clientOpenFired_flag end

    local pulseConn_stop = false
    task.spawn(function()
        while not pulseConn_stop
            and not getgenv().XvlamerHub_Cancelled
            and getgenv().XvlamerHub_DailyRunActive do
            pcall(function()
                workspace:WaitForChild("CurrentRooms", 1)
                    :WaitForChild("0", 1)
                    :WaitForChild("Door", 1)
                    :WaitForChild("ClientOpen", 1)
                    :FireServer()
                clientOpenFired_flag = true
            end)
            task.wait(0.1)
        end
    end)

    local doorOpened = waitForDoorOpen(clientOpenFired, stopToken)
    pulseConn_stop = true  -- stop the pulse regardless of outcome

    if getgenv().XvlamerHub_Cancelled or stopToken() then
        getgenv().XvlamerHub_DailyRunActive = false
        return
    end

    if not doorOpened then
        -- Door never opened — abort, don't kill or leave
        getgenv().XvlamerHub_DailyRunActive = false
        return
    end

    -- Phase 5: Door is confirmed open. Kill via replicatesignal, then leave.
    pcall(function()
        replicatesignal(game.Players.LocalPlayer.Kill)
    end)

    task.wait(1)

    if getgenv().XvlamerHub_Cancelled or stopToken() then
        getgenv().XvlamerHub_DailyRunActive = false
        return
    end

    -- Phase 6: Queue reload and fire lobby remote
    queueTeleportLoad()
    pcall(function()
        game:GetService("ReplicatedStorage")
            :WaitForChild("RemotesFolder", 10)
            :WaitForChild("Lobby", 10)
            :FireServer()
    end)

    getgenv().XvlamerHub_DailyRunActive = false
end

-- ── Save-state key for DailyRunActive persistence across teleports ────────────
-- Written to XvlamersSaveState.json so that when the script is queued via
-- queue_on_teleport and re-injected in the Ripple game, it knows to resume.
local DAILY_ACTIVE_KEY = "XvlamerHub_DailyPending"

local function saveDailyPending(val)
    pcall(function()
        -- Piggyback on the existing state table so saveState() writes it
        state.ToggleState[DAILY_ACTIVE_KEY] = val == true
        saveState()
    end)
end

local function loadDailyPending()
    return state.ToggleState[DAILY_ACTIVE_KEY] == true
end

-- ── Background watcher: triggers runDailyCompletion when token is set ─────────
task.spawn(function()
    local running = false
    while task.wait(0.3) do
        if getgenv().XvlamerHub_Cancelled then break end
        if getgenv().XvlamerHub_DailyRunActive and not running then
            running = true
            -- Persist so re-injection after teleport knows to resume
            saveDailyPending(true)
            task.spawn(function()
                runDailyCompletion()
                -- Clear pending flag once complete or aborted
                saveDailyPending(false)
                running = false
            end)
        end
        if not getgenv().XvlamerHub_DailyRunActive then
            running = false
        end
    end
end)

-- ── Ripple auto-phase watcher ─────────────────────────────────────────────────
-- Unconditional: every time the script is loaded and Ripple is detected,
-- DailyRunActive is forced true and the GUI is hidden so the run proceeds
-- without interference. No flag guard — if it's Ripple, it runs. Period.
task.spawn(function()
    -- 4 second boot settle — geometry needs to replicate before floor check is valid
    task.wait(4)

    -- Resume from previous session if the pending flag was saved
    if loadDailyPending() and not getgenv().XvlamerHub_DailyRunActive then
        getgenv().XvlamerHub_DailyRunActive = true
        pcall(function()
            if mainRef then mainRef.Visible = false end
        end)
    end

    while task.wait(1) do
        if getgenv().XvlamerHub_Cancelled then break end

        local floor = getCurrentFloor()
        local inRipple = (floor == "Ripple") or isOnDailyFloor()

        if inRipple then
            -- Force active every single check — no flag, no guard.
            if not getgenv().XvlamerHub_DailyRunActive then
                getgenv().XvlamerHub_DailyRunActive = true
            end
            -- Always hide the GUI while in Ripple so the run is unobstructed
            pcall(function()
                if mainRef then mainRef.Visible = false end
            end)
        else
            -- Outside Ripple — show GUI if run is not active
            if not getgenv().XvlamerHub_DailyRunActive then
                pcall(function()
                    if mainRef then mainRef.Visible = true end
                end)
            end
        end
    end
end)

