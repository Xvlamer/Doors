                    local waited = 0
                    while waited < 1.5 and not isCreateElevatorVisible() and not getgenv().XvlamerStop_StardustFarm do
                        task.wait(0.1)
                        waited = waited + 0.1
                    end
                end

                if getgenv().XvlamerStop_StardustFarm then
                    restoreGui()
                    return
                end

                while not getgenv().XvlamerStop_StardustFarm and isCreateElevatorVisible() do
                    local roomsBtn = getBtn(function() return P.PlayerGui.MainUI.LobbyFrame.CreateElevator.SidePanel.Frames.Floors.List.Rooms end, "Rooms")
