            Size = UDim2.new(0, 34, 0, 18), Position = UDim2.new(1, -46, 0.5, -9),
            BackgroundColor3 = Color3.fromRGB(35, 35, 46), Active = false, Parent = box,
        })
        create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = tBg })

        local tCirc = create("Frame", {
            Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(0, 2, 0.5, -7),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BorderSizePixel = 0, Active = false, Parent = tBg,
        })
        create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = tCirc })

        local on = state.ToggleState[name] == true

        local function setVisual(v)
            if getgenv().XvlamerHub_Cancelled then return end
            pcall(function()
                TS:Create(tBg, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    BackgroundColor3 = v and THEME_PURPLE or Color3.fromRGB(35, 35, 46)
                }):Play()
                TS:Create(tCirc, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Position = v and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
                }):Play()
            end)
        end

        setVisual(on)

        local obj = {
            name   = name,
            get    = function() return on end,
            setOff = function()
                on = false
                setVisual(false)
                setToggleSaved(name, false)
                cancelFarm(name)
            end,
        }

        if isRadio       then table.insert(radioToggles,     obj) end
        if isNoclipRadio then table.insert(noclipRadioGroup, obj) end
        toggleHandlers[name] = obj

        local function turnOff()
            on = false
            setVisual(false)
            setToggleSaved(name, false)
            cancelFarm(name)
        end

        local function turnOn()
            if getgenv().XvlamerHub_Cancelled then return end
            resetFarmToken(name)
            on = true
            setVisual(true)
            setToggleSaved(name, true)

            if isRadio then
                for _, r in ipairs(radioToggles) do
                    if r.name ~= name and r.get() then r.setOff() end
                end
            end
            if isNoclipRadio then
                for _, r in ipairs(noclipRadioGroup) do
                    if r.name ~= name and r.get() then r.setOff() end
                end
            end

            if name == "Autofarm" then
                task.spawn(runAutofarm)
            elseif name == "Knob Farm" then
                task.spawn(function()
                    if farmCancelled("Knob Farm") then return end
                    if isInLobby() then
                        runKnobFarmLobby()
                    else
                        runKnobFarmGame()
                    end
                end)
            elseif name == "Death Farm" then
                task.spawn(runDeathFarm)
            elseif name == "Stardust Farm" then
                task.spawn(function()
                    if farmCancelled("Stardust Farm") then return end
                    if isInLobby() then
                        runStardustFarmLobby()
                    else
                        runStardustFarmGame()
                    end
                end)
            elseif name == "Noclip" then
                task.spawn(runNoclip)
            elseif name == "Noclip SPAM" then
                task.spawn(runNoclipSpam)
            elseif name == "Optimizations" then
                task.spawn(runOptimizations)
            elseif name == "Anti-AFK" then
                startAntiAfk()
            end
        end

        obj.turnOnSilent = turnOn

        local function handleClick()
            if getgenv().XvlamerHub_Cancelled then return end
            if on then
                if name == "Anti-AFK" then stopAntiAfk() end
                turnOff()
                return
            end
            turnOn()
        end

        onDebouncedClick(box, handleClick, 0)
        return obj
    end

