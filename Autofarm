local function cancelFarm(name)
    local token = FARM_TOKENS[name]
    if token then
        getgenv()[token] = true
    end
end

local function resetFarmToken(name)
    local token = FARM_TOKENS[name]
    if token then
        getgenv()[token] = false
    end
end

local function farmCancelled(name)
    local token = FARM_TOKENS[name]
    if not token then return getgenv().XvlamerHub_Cancelled end
    return getgenv().XvlamerHub_Cancelled or getgenv()[token] == true
end

