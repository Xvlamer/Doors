        msgLbl.TextSize             = 13
        msgLbl.TextWrapped          = true
        msgLbl.TextXAlignment       = Enum.TextXAlignment.Center
        msgLbl.TextYAlignment       = Enum.TextYAlignment.Center

        local cBtn, cfBtn

        if cancelText ~= "" then
            cBtn = Instance.new("TextButton", frame)
            cBtn.Size             = UDim2.new(0.46, -6, 0, 40)
            cBtn.Position         = UDim2.new(0, 15, 1, -52)
            cBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 33)
            cBtn.Font             = Enum.Font.GothamBold
            cBtn.Text             = cancelText
            cBtn.TextColor3       = Color3.fromRGB(200, 200, 215)
            cBtn.TextSize         = 13
            Instance.new("UICorner", cBtn).CornerRadius = UDim.new(0, 9)

            cfBtn = Instance.new("TextButton", frame)
            cfBtn.Size            = UDim2.new(0.46, -6, 0, 40)
            cfBtn.Position        = UDim2.new(0.54, -1, 1, -52)
            cfBtn.BackgroundColor3 = THEME_PURPLE
            cfBtn.Font            = Enum.Font.GothamBold
            cfBtn.Text            = countdownSeconds
                and string.format("%s (%d)", confirmText or "Proceed", countdownSeconds)
                or  (confirmText or "Confirm")
            cfBtn.TextColor3      = Color3.fromRGB(255, 255, 255)
            cfBtn.TextSize        = 13
            Instance.new("UICorner", cfBtn).CornerRadius = UDim.new(0, 9)
        else
            cfBtn = Instance.new("TextButton", frame)
            cfBtn.Size            = UDim2.new(1, -30, 0, 40)
            cfBtn.Position        = UDim2.new(0, 15, 1, -52)
            cfBtn.BackgroundColor3 = THEME_PURPLE
            cfBtn.Font            = Enum.Font.GothamBold
