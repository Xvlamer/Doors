        create("UICorner", {CornerRadius=UDim.new(1,0), Parent=tCirc})
        
        local on = false
        local function setVisual(onState)
            pcall(function()
                TS:Create(tBg, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = onState and THEME_PURPLE or Color3.fromRGB(35, 35, 46)}):Play()
                TS:Create(tCirc, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = onState and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7)}):Play()
            end)
        end

        local toggleObj = {
            name = name, 
            set = setVisual, 
            get = function() return on end, 
            setOff = function(v) 
                on = v
                setVisual(v)
                if isRadio then
                    if state.ActiveFarm == name then
                        state.ActiveFarm = nil
                        pcall(saveState)
                    end
                elseif stateKey then
                    if state[stateKey] then
                        state[stateKey] = false
                        pcall(saveState)
                    end
                end
            end
        }
        if isRadio then table.insert(radioToggles, toggleObj) end

        local function updateState(newState, skipWarning)
            on = newState
            setVisual(on)
            
            if isRadio then
                if on then
                    if name == "Knob Farm" and not skipWarning then
                        if isInLobby() then
                            setVisual(false)
                            on = false
                            if state.ActiveFarm == name then
                                state.ActiveFarm = nil
                                pcall(saveState)
                            end
                            showPopupModal(
                                "XvlamersModifiersPrompt",
                                "⚠️ 150% MODIFIERS",
                                "Use 150% Modifiers in the mines and collect the most gold for maximum Knobs.",
                                "",
                                "Proceed",
                                function() end,
                                function()
                                    setVisual(false)
                                    on = false
                                    if state.ActiveFarm == name then
                                        state.ActiveFarm = nil
                                        pcall(saveState)
                                    end
                                end
                            )
                            return
                        else
                            local currentFloor = getFloor()
                            if currentFloor ~= "Hotel" and currentFloor ~= "Mines" then
                                setVisual(false)
                                on = false
                                if state.ActiveFarm == name then
                                    state.ActiveFarm = nil
                                    pcall(saveState)
                                end
                                showPopupModal(
                                    "XvlamersKnobFloorWarning",
                                    "⚠️ WRONG LOCATION",
                                    "Knob Farm must be run in either the Mines or Hotel. We recommend 150% modifiers in the Mines.",
                                    "",
                                    "Proceed",
                                    function() end,
                                    function() end
                                )
                                return
                            elseif getGoldValue() <= 0 then
                                setVisual(false)
                                on = false
                                if state.ActiveFarm == name then
                                    state.ActiveFarm = nil
                                    pcall(saveState)
                                end
                                showPopupModal(
                                    "XvlamersZeroGoldWarning",
                                    "⚠️ 0 GOLD",
                                    "You have 0 gold collect more to start.",
                                    "",
                                    "Proceed",
                                    function() end,
                                    function()
                                        setVisual(false)
                                        on = false
                                        if state.ActiveFarm == name then
                                            state.ActiveFarm = nil
                                            pcall(saveState)
                                        end
                                    end
                                )
                                return
                            else
                                for _, r in ipairs(radioToggles) do if r.name ~= name and r.get() then r.setOff(false) end end
                                state.ActiveFarm = name
                                pcall(saveState)
                                runThread(name)
                            end
                        end
                    elseif name == "Death Farm" and not skipWarning then
                        setVisual(false)
                        on = false
                        showPopupModal(
                            "XvlamersDeathFarmWarning",
                            "⚠️ DEATH FARM",
                            "Death farm uses advanced techniques for the most precision and speed and you must re open Roblox to completely stop it.",
                            "Cancel",
                            "Proceed",
                            function()
                                setVisual(false)
                                on = false
                                if state.ActiveFarm == name then
                                    state.ActiveFarm = nil
                                    pcall(saveState)
                                end
                            end,
                            function()
                                for _, r in ipairs(radioToggles) do if r.name ~= name and r.get() then r.setOff(false) end end
                                setVisual(true)
                                on = true
                                state.ActiveFarm = name
                                pcall(saveState)
                                runThread(name)
                            end
                        )
                    elseif name == "Stardust Farm" and not skipWarning then
                        setVisual(false)
                        on = false
                        
                        if not isInLobby() then
                            local currentFloor = getFloor()
                            if currentFloor ~= "Rooms" then
                                if state.ActiveFarm == name then
                                    state.ActiveFarm = nil
                                    pcall(saveState)
                                end
                                showPopupModal(
                                    "XvlamersStardustFloorWarning",
                                    "⚠️ WRONG LOCATION",
                                    "You must run Stardust Farm inside of the Rooms.",
                                    "",
                                    "Proceed",
                                    function() end,
                                    function() end
                                )
                                return
                            end
                        end

                        showPopupModal(
                            "XvlamersStardustFarmWarning",
                            "⚠️ STARDUST FARM",
                            "Would you like to start the Stardust Farm? Do not touch your device while it is in action.",
                            "Cancel",
                            "Proceed",
                            function()
                                setVisual(false)
                                on = false
                                if state.ActiveFarm == name then
                                    state.ActiveFarm = nil
                                    pcall(saveState)
                                end
                            end,
                            function()
                                for _, r in ipairs(radioToggles) do if r.name ~= name and r.get() then r.setOff(false) end end
                                setVisual(true)
                                on = true
                                state.ActiveFarm = name
                                pcall(saveState)
                                runThread(name)
                            end
                        )
                    else
                        for _, r in ipairs(radioToggles) do if r.name ~= name and r.get() then r.setOff(false) end end
                        if name ~= "Knob Farm" then
                            state.ActiveFarm = name
                            pcall(saveState)
                        end
                        runThread(name)
                    end
                else
                    if state.ActiveFarm == name then state.ActiveFarm = nil; pcall(saveState) end
                    stopThread(name)
                end
            else
                if stateKey then state[stateKey] = on; pcall(saveState) end
                if stateKey == "Optimizations" then Optimizer.Toggle(on)
                elseif stateKey == "AntiAFK" then setAntiAFK(on)
                elseif stateKey == "UnlockFps" then setUnlockFPS(on)
                elseif name == "Noclip" then
                    if on then
                        local spamToggle = toggleHandlers["Noclip SPAM"]
                        if spamToggle and spamToggle.get() then
                            spamToggle.update(false)
                        end
                        NoclipModule.Toggle(true)
                    else
                        NoclipModule.Toggle(false)
                    end
                elseif name == "Noclip SPAM" then
                    if on then
                        local noclipToggle = toggleHandlers["Noclip"]
                        if noclipToggle and noclipToggle.get() then
                            noclipToggle.update(false)
                        end
                        NoclipModule.ToggleSpam(true)
                    else
                        NoclipModule.ToggleSpam(false)
                    end
                else 
                    if on then runThread(name) else stopThread(name) end 
                end
            end
        end

        toggleObj.update = updateState
        if isRadio then toggleHandlers[name] = toggleObj elseif stateKey then toggleHandlers[stateKey] = toggleObj else toggleHandlers[name] = toggleObj end

        onDebouncedClick(box, function()
            updateState(not on)
        end, 0.2)

        if stateKey and state[stateKey] == true then
            on = true
            setVisual(true)
            if stateKey == "Optimizations" then Optimizer.Toggle(true)
            elseif stateKey == "AntiAFK" then setAntiAFK(true, true)
            elseif stateKey == "UnlockFps" then setUnlockFPS(true, true) end
        end
    end

    createToggle("Knob Farm", pages[2], true, nil, 1, 36)
    createToggle("Death Farm", pages[2], true, nil, 2, 36)
    createToggle("Stardust Farm", pages[2], true, nil, 3, 36)

    createToggle("Noclip", pages[3], false, nil, 1, 36)
    createToggle("Noclip SPAM", pages[3], false, nil, 2, 36)
    createToggle("Optimizations", pages[3], false, "Optimizations", 3, 36)
    createToggle("Unlock fps", pages[3], false, "UnlockFps", 4, 36)
    createToggle("Anti-AFK", pages[3], false, "AntiAFK", 5, 36)

    trackConnection(UIS.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == Enum.KeyCode.V then
            if not UIS:GetFocusedTextBox() then
                local noclipToggle = toggleHandlers["Noclip"]
                if noclipToggle and type(noclipToggle.update) == "function" and type(noclipToggle.get) == "function" then
                    noclipToggle.update(not noclipToggle.get())
                end
            end
        elseif not gpe and input.KeyCode == Enum.KeyCode.B then
            if not UIS:GetFocusedTextBox() then
                local spamToggle = toggleHandlers["Noclip SPAM"]
                if spamToggle and type(spamToggle.update) == "function" and type(spamToggle.get) == "function" then
                    spamToggle.update(not spamToggle.get())
                end
            end
        end
    end))
end

local function showStartupAutofarmPrompt(onComplete)
    if pendingStartupFarm then
        local savedStartupFarm = pendingStartupFarm
        pendingStartupFarm = nil
        
        if savedStartupFarm ~= "Stardust Farm" then
            if onComplete then onComplete(nil) end
            return
        end
        
        local countdown = (savedStartupFarm == "Stardust Farm") and (isInLobby() and 5 or 3) or nil
        
        showPopupModal(
            "XvlamersStartupAutofarmPrompt",
            string.format("⚙️ %s", string.upper(savedStartupFarm)),
            string.format("Would you like to proceed with the %s or cancel it?", savedStartupFarm),
            "Cancel",
            "Proceed",
            function()
                if onComplete then onComplete(nil) end
            end,
            function()
                if onComplete then onComplete(savedStartupFarm) end
            end,
            countdown
        )
    else
        if onComplete then onComplete(nil) end
    end
end

local function startKeySystem()
    local keyGui = create("ScreenGui", {Name="XvlamersKeySystem", ResetOnSpawn=false, ZIndexBehavior=Enum.ZIndexBehavior.Sibling, DisplayOrder=999, Parent=safeUI})
    pcall(function() if syn and syn.protect_gui then syn.protect_gui(keyGui) end end)

    local keyFrame = create("Frame", {
        Size=UDim2.new(0, 320, 0, 145), 
        Position=UDim2.new(0.5, 0, 0.5, 0), 
        AnchorPoint=Vector2.new(0.5, 0.5), 
        BackgroundColor3=Color3.fromRGB(11, 11, 15), 
        BorderSizePixel=0, 
        BackgroundTransparency=0, 
        ClipsDescendants=true,
        Parent=keyGui
    })
    create("UICorner", {CornerRadius=UDim.new(0, 14), Parent=keyFrame})
    create("UIStroke", {Color=THEME_PURPLE, Transparency=0.15, Thickness=1.5, Parent=keyFrame})

    makeUniversalDraggable(keyFrame)

    _G.XvlamerHub_CloseKeySystem = function() 
        pcall(function() 
            keyGui:Destroy() 
        end) 
    end

    local closeKeyBtn = create("TextButton", {Size=UDim2.new(0, 24, 0, 24), Position=UDim2.new(1, -32, 0, 12), BackgroundColor3=Color3.fromRGB(20, 20, 28), Font=Enum.Font.GothamBold, Text="✕", TextColor3=Color3.fromRGB(180, 180, 200), TextSize=10, Parent=keyFrame})
    create("UICorner", {CornerRadius=UDim.new(0, 7), Parent=closeKeyBtn})
    onDebouncedClick(closeKeyBtn, function() _G.XvlamerHub_CloseKeySystem() end, 0.2)

    create("TextLabel", {Size=UDim2.new(1, -40, 0, 12), Position=UDim2.new(0, 15, 0, 12), BackgroundTransparency=1, Font=Enum.Font.GothamBold, Text="AUTHENTICATION", TextColor3=THEME_PURPLE, TextSize=10, TextXAlignment=Enum.TextXAlignment.Left, Parent=keyFrame})
    create("TextLabel", {Size=UDim2.new(1, -40, 0, 16), Position=UDim2.new(0, 15, 0, 24), BackgroundTransparency=1, Font=Enum.Font.GothamBold, Text="You must get the key from the script owner.", TextColor3=Color3.fromRGB(245, 245, 255), TextSize=11, TextXAlignment=Enum.TextXAlignment.Left, Parent=keyFrame})

    local errorLbl = create("TextLabel", {Size=UDim2.new(1, -30, 0, 14), Position=UDim2.new(0, 15, 0, 42), BackgroundTransparency=1, Font=Enum.Font.GothamBold, Text="", TextColor3=Color3.fromRGB(255, 85, 85), TextSize=10, TextXAlignment=Enum.TextXAlignment.Left, Parent=keyFrame})

    local textBoxBg = create("Frame", {Size=UDim2.new(1, -30, 0, 32), Position=UDim2.new(0, 15, 0, 62), BackgroundColor3=Color3.fromRGB(15, 15, 22), Parent=keyFrame})
    create("UICorner", {CornerRadius=UDim.new(0, 9), Parent=textBoxBg})
    create("UIStroke", {Color=Color3.fromRGB(45, 45, 60), Transparency=0.2, Thickness=1, Parent=textBoxBg})

    local keyInput = create("TextBox", {Size=UDim2.new(1, -16, 1, 0), Position=UDim2.new(0, 8, 0, 0), BackgroundTransparency=1, Font=Enum.Font.GothamBold, PlaceholderText="Enter key here...", Text="", TextColor3=Color3.fromRGB(255, 255, 255), PlaceholderColor3=Color3.fromRGB(110, 110, 135), TextSize=11, ClearTextOnFocus=false, Parent=textBoxBg})

    local confirmBtn = create("TextButton", {Size=UDim2.new(1, -30, 0, 32), Position=UDim2.new(0, 15, 0, 102), BackgroundColor3=THEME_PURPLE, Font=Enum.Font.GothamBold, Text="Confirm", TextColor3=Color3.fromRGB(255, 255, 255), TextSize=11, AutoButtonColor=false, Parent=keyFrame})
    create("UICorner", {CornerRadius=UDim.new(0, 9), Parent=confirmBtn})

    local function handleKeyConfirm()
        if keyInput.Text == CORRECT_KEY then
            state.KeyExpiry = os.time() + 86400
            pcall(saveState)
            _G.XvlamerHub_CloseKeySystem()
            
            initializeMainHub()
            showStartupAutofarmPrompt(function(resumedFarm)
                if resumedFarm then
                    local toggleObj = toggleHandlers[resumedFarm]
                    if toggleObj and type(toggleObj.update) == "function" then
                        toggleObj.update(true, true)
                    end
                end
            end)
        else
            errorLbl.Text = "Incorrect key! Verify with the script owner."
        end
    end
    onDebouncedClick(confirmBtn, handleKeyConfirm, 0.2)
end

local passedKey = select(1, ...)
local globalKey = getgenv().Key or _G.Key or getgenv().XvlamerKey or (rawget(_G, "Key"))

if (passedKey == CORRECT_KEY) or (globalKey == CORRECT_KEY) or (state.KeyExpiry and os.time() < state.KeyExpiry) then
    state.KeyExpiry = os.time() + 86400
    pcall(saveState)
    
    initializeMainHub()
    showStartupAutofarmPrompt(function(resumedFarm)
        if resumedFarm then
            local toggleObj = toggleHandlers[resumedFarm]
            if toggleObj and type(toggleObj.update) == "function" then
                toggleObj.update(true, true)
            end
        end
    end)
else
    startKeySystem()
end
