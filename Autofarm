            and v.Name ~= "XvlamersMobileToggle" then
            return true
        end
    end
    return false
end

local function makeUniversalDraggable(frame)
    local dragging, dragInput, dragStart, startPos
    trackConnection(frame.InputBegan:Connect(function(input)
        if getgenv().XvlamerHub_Cancelled then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            local mp      = UIS:GetMouseLocation()
            local objects = safeUI:GetGuiObjectsAtPosition(mp.X, mp.Y)
            local blocked = false
            for _, obj in ipairs(objects) do
                if obj == frame then break end
                if obj:IsA("TextButton") or obj:IsA("TextBox") or obj:IsA("ImageButton") then
                    blocked = true; break
                end
            end
            if not blocked then
                dragging  = true
                dragStart = input.Position
                startPos  = frame.Position
                local ec
                ec = input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                        pcall(function() ec:Disconnect() end)
                    end
                end)
                trackConnection(ec)
            end
        end
    end))
    trackConnection(UIS.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end))
    trackConnection(UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragging and not getgenv().XvlamerHub_Cancelled then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end))
end

