            if visible and isModalOpen() then return end
            main.Visible = visible
        end)
    end

    trackConnection(UIS.InputBegan:Connect(function(input)
        if getgenv().XvlamerHub_Cancelled then return end
        if input.KeyCode == Enum.KeyCode.LeftAlt
            or input.KeyCode == Enum.KeyCode.RightAlt then
