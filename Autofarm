local function create(className, props)
    local ok, inst = pcall(function()
        local i = Instance.new(className)
        for k, v in pairs(props) do i[k] = v end
        return i
    end)
    return ok and inst or Instance.new("Frame")
end

local function onDebouncedClick(btn, callback, cooldown)
    cooldown = cooldown or 0
    local last = 0
    local function trigger()
        if getgenv().XvlamerHub_Cancelled then return end
        local now = tick()
        if now - last < cooldown then return end
        last = now
        pcall(callback)
    end
    trackConnection(btn.MouseButton1Click:Connect(trigger))
    if isMobile then
        pcall(function() trackConnection(btn.Activated:Connect(trigger)) end)
        pcall(function() trackConnection(btn.TouchTap:Connect(trigger)) end)
    end
end

local function isModalOpen()
    for _, v in pairs(safeUI:GetChildren()) do
        if v:IsA("ScreenGui")
            and v.Name:match("^Xvlamers")
            and v.Name ~= guiName
            and v.Name ~= "XvlamersMobileToggle" then
            return true
        end
    end
    return false
end

local function makeUniversalDraggable(frame)
    local dragging, dragInput, dragStart, startPos
    trackConnection(frame.InputBegan:Connect(function(input)
        if getgenv().XvlamerHub_Cancelled then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            local mp      = UIS:GetMouseLocation()
            local objects = safeUI:GetGuiObjectsAtPosition(mp.X, mp.Y)
            local blocked = false
            for _, obj in ipairs(objects) do
                if obj == frame then break end
                if obj:IsA("TextButton") or obj:IsA("TextBox") or obj:IsA("ImageButton") then
                    blocked = true; break
                end
            end
            if not blocked then
                dragging  = true
                dragStart = input.Position
                startPos  = frame.Position
                local ec
                ec = input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                        pcall(function() ec:Disconnect() end)
                    end
                end)
                trackConnection(ec)
            end
        end
    end))
    trackConnection(UIS.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end))
    trackConnection(UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragging and not getgenv().XvlamerHub_Cancelled then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end))
end

local function showPopupModal(
    modalName, titleText, messageText,
    cancelText, confirmText,
    onCancel, onConfirm,
    countdownSeconds
)
    if getgenv().XvlamerHub_Cancelled then return end
    pcall(function()
        local wasVisible = mainRef and mainRef.Visible or false
        if mainRef then mainRef.Visible = false end

        local wGui = Instance.new("ScreenGui")
        wGui.Name            = modalName
        wGui.ResetOnSpawn    = false
        wGui.ZIndexBehavior  = Enum.ZIndexBehavior.Sibling
        wGui.DisplayOrder    = 1000000
        wGui.Parent          = safeUI

        local frame = Instance.new("Frame")
        frame.Size             = UDim2.new(0, 340, 0, 185)
        frame.Position         = UDim2.new(0.5, 0, 0.5, 0)
        frame.AnchorPoint      = Vector2.new(0.5, 0.5)
        frame.BackgroundColor3 = Color3.fromRGB(13, 13, 17)
        frame.BorderSizePixel  = 0
        frame.ClipsDescendants = true
        frame.Parent           = wGui
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 14)
        local stroke = Instance.new("UIStroke", frame)
        stroke.Color        = THEME_PURPLE
        stroke.Transparency = 0.3
        stroke.Thickness    = 1.5

        local titleLbl = Instance.new("TextLabel", frame)
        titleLbl.Size               = UDim2.new(1, -30, 0, 24)
        titleLbl.Position           = UDim2.new(0, 15, 0, 16)
        titleLbl.BackgroundTransparency = 1
        titleLbl.Font               = Enum.Font.GothamBold
        titleLbl.Text               = titleText
        titleLbl.TextColor3         = Color3.fromRGB(255, 255, 255)
        titleLbl.TextSize           = 14
        titleLbl.TextXAlignment     = Enum.TextXAlignment.Center

        local msgLbl = Instance.new("TextLabel", frame)
        msgLbl.Size                 = UDim2.new(1, -36, 0, 84)
        msgLbl.Position             = UDim2.new(0, 18, 0, 46)
        msgLbl.BackgroundTransparency = 1
        msgLbl.Font                 = Enum.Font.GothamBold
        msgLbl.Text                 = messageText
        msgLbl.TextColor3           = Color3.fromRGB(215, 215, 230)
        msgLbl.TextSize             = 13
        msgLbl.TextWrapped          = true
        msgLbl.TextXAlignment       = Enum.TextXAlignment.Center
        msgLbl.TextYAlignment       = Enum.TextYAlignment.Center

        local cBtn, cfBtn

        if cancelText ~= "" then
            cBtn = Instance.new("TextButton", frame)
            cBtn.Size             = UDim2.new(0.46, -6, 0, 40)
            cBtn.Position         = UDim2.new(0, 15, 1, -52)
            cBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 33)
            cBtn.Font             = Enum.Font.GothamBold
            cBtn.Text             = cancelText
            cBtn.TextColor3       = Color3.fromRGB(200, 200, 215)
            cBtn.TextSize         = 13
            Instance.new("UICorner", cBtn).CornerRadius = UDim.new(0, 9)

            cfBtn = Instance.new("TextButton", frame)
            cfBtn.Size            = UDim2.new(0.46, -6, 0, 40)
            cfBtn.Position        = UDim2.new(0.54, -1, 1, -52)
            cfBtn.BackgroundColor3 = THEME_PURPLE
            cfBtn.Font            = Enum.Font.GothamBold
            cfBtn.Text            = countdownSeconds
                and string.format("%s (%d)", confirmText or "Proceed", countdownSeconds)
                or  (confirmText or "Confirm")
            cfBtn.TextColor3      = Color3.fromRGB(255, 255, 255)
            cfBtn.TextSize        = 13
            Instance.new("UICorner", cfBtn).CornerRadius = UDim.new(0, 9)
        else
            cfBtn = Instance.new("TextButton", frame)
            cfBtn.Size            = UDim2.new(1, -30, 0, 40)
            cfBtn.Position        = UDim2.new(0, 15, 1, -52)
            cfBtn.BackgroundColor3 = THEME_PURPLE
            cfBtn.Font            = Enum.Font.GothamBold
            cfBtn.Text            = confirmText or "OK"
            cfBtn.TextColor3      = Color3.fromRGB(255, 255, 255)
            cfBtn.TextSize        = 13
            Instance.new("UICorner", cfBtn).CornerRadius = UDim.new(0, 9)
        end

        local activeCountdown = true
        local closing         = false

        local function close(cb)
            if closing then return end
            closing         = true
            activeCountdown = false
            pcall(function()
                wGui:Destroy()
                if mainRef and not getgenv().XvlamerHub_Cancelled then mainRef.Visible = wasVisible end
                if cb and not getgenv().XvlamerHub_Cancelled then cb() end
            end)
        end

        if cBtn then
            onDebouncedClick(cBtn, function() close(onCancel) end, 0.2)
        end
        onDebouncedClick(cfBtn, function() close(onConfirm) end, 0.2)

        if countdownSeconds and countdownSeconds > 0 then
            task.spawn(function()
                for i = countdownSeconds - 1, 0, -1 do
                    task.wait(1)
                    if getgenv().XvlamerHub_Cancelled or not activeCountdown or not wGui.Parent then break end
                    cfBtn.Text = string.format("%s (%d)", confirmText or "Proceed", i)
                end
                if not getgenv().XvlamerHub_Cancelled and activeCountdown and wGui.Parent then
                    close(onConfirm)
                end
            end)
        end
    end)
end

