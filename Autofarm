local function loadAndRunUrl(url)
    local success, response = pcall(function()
        return game:HttpGet(url)
    end)
    if not success then
        warn("[HttpError]: Failed to fetch URL ->", url, response)
        return false
    end
    if response:match("404: Not Found") or response:match("<!DOCTYPE html>") then
        warn("[GitHub Error]: The raw URL returned an HTML page or 404 for ->", url)
        return false
    end
    local fn, syntaxError = loadstring(response)
    if not fn then
        warn("[SyntaxError]: Failed to compile script ->", url, syntaxError)
        return false
    end
    local runSuccess, runError = pcall(fn)
    if not runSuccess then
        warn("[RuntimeError]: Script crashed during execution ->", url, runError)
        return false
    end
    return true
end

