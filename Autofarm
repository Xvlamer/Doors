local function getCurrentFloor()
    if isInLobby() then return "Lobby" end
    local ok, res = pcall(function()
        local gameData = game:GetService("ReplicatedStorage"):FindFirstChild("GameData")
        if gameData then
            local floorVal = gameData:FindFirstChild("Floor")
            if floorVal and (floorVal:IsA("StringValue") or floorVal:IsA("ValueBase")) then
                local val = tostring(floorVal.Value)
                if val ~= "" then return val end
            end
        end
    end)
    return (ok and res and res ~= "") and res or "Hotel"
end

local function getGoldValue()
    local gold = 0
    pcall(function()
        local g = P:FindFirstChild("Gold")
        if not g and P:FindFirstChild("leaderstats") then
            g = P.leaderstats:FindFirstChild("Gold")
        end
        if not g then
            for _, d in pairs(P:GetDescendants()) do
                if d.Name == "Gold" and (d:IsA("IntValue") or d:IsA("NumberValue")) then
                    g = d; break
                end
            end
        end
        if g then gold = g.Value end
    end)
    return gold
end

