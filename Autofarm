    pcall(function() destroyOwned(game:GetService("CoreGui")) end)
    pcall(function() destroyOwned(gethui()) end)
    pcall(function() destroyOwned(P:FindFirstChild("PlayerGui")) end)

    if getgenv().XvlamerHub_RunningInstance == purge then
        getgenv().XvlamerHub_RunningInstance = nil
    end
end

