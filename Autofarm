    local function runThread(key)
        stopThread(key)
        if key == "Knob Farm" then
            if not isInLobby() then
                getgenv().XvlamerStop_KnobFarm = false
                activeThreads[key] = task.spawn(function()
                    loadAndRunUrl("https://raw.githubusercontent.com/Xvlamer/Doors/refs/heads/main/Autofarm%20Knobs")
                end)
            end
        elseif key == "Death Farm" then
            getgenv().XvlamerStop_DeathFarm = false
            activeThreads[key] = task.spawn(function()
                loadAndRunUrl("https://raw.githubusercontent.com/Xvlamer/Doors/refs/heads/main/Autofarm%20Deaths")
            end)
        elseif key == "Stardust Farm" then
            getgenv().XvlamerStop_StardustFarm = false
            activeThreads[key] = task.spawn(function()
                local wasMainVisible = mainRef and mainRef.Visible or false
                if mainRef then mainRef.Visible = false end
                local mGuiRef = safeUI:FindFirstChild("XvlamersMobileToggle")
                if mGuiRef then mGuiRef.Enabled = false end

                local function restoreGui()
                    if mainRef then mainRef.Visible = wasMainVisible end
                    local mGuiCheck = safeUI:FindFirstChild("XvlamersMobileToggle")
                    if mGuiCheck then mGuiCheck.Enabled = true end
                end

                local function clickBtn(btn)
                    if btn then
                        pcall(function()
                            if typeof(btn.Activate) == "function" then
                                btn:Activate()
                            end
                        end)
                        pcall(function()
                            if firesignal then
                                firesignal(btn.MouseButton1Click)
                                firesignal(btn.Activated)
                            end
                        end)
                        pcall(function()
                            if getconnections then
                                for _, conn in pairs(getconnections(btn.MouseButton1Click)) do
                                    conn:Fire()
                                end
                                for _, conn in pairs(getconnections(btn.Activated)) do
                                    conn:Fire()
                                end
                            end
                        end)
                        pcall(function()
                            local pos = btn.AbsolutePosition + (btn.AbsoluteSize / 2)
                            if pos.X > 0 and pos.Y > 0 then
                                VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
                                task.wait(0.01)
                                VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
                            end
                        end)
                    end
                end

                local function getBtn(pathFn, fallbackName)
                    local found = nil
                    pcall(function() found = pathFn() end)
                    if not found and fallbackName then
                        pcall(function()
                            for _, desc in ipairs(P.PlayerGui.MainUI.LobbyFrame:GetDescendants()) do
                                if desc.Name == fallbackName then found = desc; break end
                            end
                        end)
                    end
                    return found
                end

                local function isCreateElevatorVisible()
                    local res = false
                    pcall(function()
                        res = P.PlayerGui.MainUI.LobbyFrame.CreateElevator.Visible
                    end)
                    return res
                end

                while not getgenv().XvlamerStop_StardustFarm and not isCreateElevatorVisible() do
                    local playBtn = getBtn(function() return P.PlayerGui.MainUI.LobbyFrame.BottomButtons.MainPlayButton end, "MainPlayButton")
