                mStartPos  = mBtn.Position
                local ec
                ec = input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        mDragging = false
                        pcall(function() ec:Disconnect() end)
                    end
                end)
                trackConnection(ec)
            end
        end))
        trackConnection(UIS.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                mDragInput = input
            end
        end))
        trackConnection(UIS.InputChanged:Connect(function(input)
            if input == mDragInput and mDragging and not getgenv().XvlamerHub_Cancelled then
                local d = input.Position - mDragStart
                if math.abs(d.X) > 5 or math.abs(d.Y) > 5 then hasDragged = true end
                mBtn.Position = UDim2.new(
                    mStartPos.X.Scale, mStartPos.X.Offset + d.X,
                    mStartPos.Y.Scale, mStartPos.Y.Offset + d.Y
                )
            end
        end))
        onDebouncedClick(mBtn, function()
            if hasDragged then return end
            setMainGuiVisible(not main.Visible)
        end, 0.2)
    end

