        local function turnOff()
            on = false
            setVisual(false)
            setToggleSaved(name, false)
            cancelFarm(name)
            if name == "Knob Farm" then setMainGuiVisible(true) end
        end

        local function turnOn()
            if getgenv().XvlamerHub_Cancelled then return end
            resetFarmToken(name)
            on = true
            setVisual(true)
            setToggleSaved(name, true)

            if name == "Knob Farm" then setMainGuiVisible(false) end

            if isRadio then
                for _, r in ipairs(radioToggles) do
                    if r.name ~= name and r.get() then r.setOff() end
                end
            end
            if isNoclipRadio then
                for _, r in ipairs(noclipRadioGroup) do
                    if r.name ~= name and r.get() then r.setOff() end
                end
            end

            if name == "Knob Farm" then
                task.spawn(function()
                    if farmCancelled("Knob Farm") then return end
                    if isInLobby() then runKnobFarmLobby() else runKnobFarmGame() end
                end)
            elseif name == "Death Farm" then
                task.spawn(runDeathFarm)
            elseif name == "Stardust Farm" then
                task.spawn(function()
                    if farmCancelled("Stardust Farm") then return end
                    if isInLobby() then runStardustFarmLobby() else runStardustFarmGame() end
                end)
            elseif name == "Noclip" then
                task.spawn(runNoclip)
            elseif name == "Noclip SPAM" then
                task.spawn(runNoclipSpam)
            elseif name == "Optimizations" then
                task.spawn(runOptimizations)
            elseif name == "Anti-AFK" then
                startAntiAfk()
            end
        end

        obj.turnOnSilent = turnOn

        local function handleClick()
            if getgenv().XvlamerHub_Cancelled then return end
            if on then
                if name == "Anti-AFK" then stopAntiAfk() end
                turnOff()
                return
            end

            if name == "Knob Farm" then
                local floor = getCurrentFloor()
                local isValidFloor = isInLobby() or floor == "Hotel" or floor == "Mines"
                if not isValidFloor then
                    showPopupModal(
                        "XvlamersInvalidFloorWarning", "⚠️ RESTRICTED LOCATION",
                        "Knob Farm can only be executed while in the Lobby, Hotel, or Mines.",
                        "", "OK", function() end, function() end
                    )
                    turnOff(); return
                end
                if isInLobby() then
                    showPopupModal(
                        "XvlamersModifiersPrompt", "⚠️ CUSTOM MODIFIERS",
                        "Use custom modifiers in the mines and collect the most gold for maximum Knobs.",
                        "Cancel", "Proceed",
                        function() turnOff() end, function() turnOn() end
                    )
                else
                    if getGoldValue() <= 0 then
                        showPopupModal(
                            "XvlamersZeroGoldWarning", "⚠️ 0 GOLD",
                            "You have 0 gold. Collect more gold before starting Knob Farm.",
                            "", "OK", function() end, function() end
                        )
                        turnOff(); return
                    end
                    turnOn()
                end
                return
            end

            if name == "Death Farm" then
                showPopupModal(
                    "XvlamersDeathFarmWarning", "⚠️ DEATH FARM",
                    "Death farm uses advanced techniques and you must re open Roblox to completely stop it.",
                    "Cancel", "Proceed",
                    function() turnOff() end, function() turnOn() end
                )
                return
            end

            if name == "Stardust Farm" then
                local floor = getCurrentFloor()
                local isValidFloor = isInLobby() or floor == "Archives"
                if not isValidFloor then
                    showPopupModal(
                        "XvlamersInvalidStardustFloor", "⚠️ RESTRICTED LOCATION",
                        "Stardust Farm must be ran in Archives to work.",
                        "", "OK", function() end, function() end
                    )
                    turnOff(); return
                end
                if isInLobby() then
                    showPopupModal(
                        "XvlamersStardustFarmWarning", "⚠️ STARDUST FARM",
                        "Would you like to start the Stardust Farm? Do not touch your device while active.",
                        "Cancel", "Proceed",
                        function() turnOff() end, function() turnOn() end
                    )
                else
                    showPopupModal(
                        "XvlamersStardustFarmWarning", "⚠️ STARDUST FARM",
                        "Stardust Farm resuming. Auto-confirming in 5 seconds if no response.",
                        "Cancel", "Proceed",
                        function() turnOff() end, function() turnOn() end, 5
                    )
                end
                return
            end

            turnOn()
        end

        onDebouncedClick(box, handleClick, 0)
        return obj
    end

    -- ── Daily Run button — plain text toggle style, no icon badge ─────────────
    local function createDailyRunButton(parentPage, order)
        local box = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundColor3 = Color3.fromRGB(18, 18, 24),
            Text = "", AutoButtonColor = false, Active = true,
            LayoutOrder = order, Parent = parentPage,
        })
        create("UICorner", { CornerRadius = UDim.new(0, 9), Parent = box })
        create("UIStroke",  { Color = Color3.fromRGB(45, 45, 60), Transparency = 0.2, Thickness = 1, Parent = box })

        local lbl = create("TextLabel", {
            Size = UDim2.new(1, -16, 1, 0), Position = UDim2.new(0, 12, 0, 0),
            BackgroundTransparency = 1, Active = false,
            Font = Enum.Font.GothamBold, Text = "Complete Daily Run",
            TextColor3 = Color3.fromRGB(245, 245, 255), TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = box,
        })

        onDebouncedClick(box, function()
            if getgenv().XvlamerHub_Cancelled then return end

            local inLobby = isInLobby()
            local onDaily = isOnDailyFloor()

            if not inLobby and not onDaily then
                showPopupModal(
                    "XvlamersDailyFloorWarning", "⚠️ DAILY COMPLETION",
                    "This must be ran inside the Daily Run or Lobby for it to work.",
                    "", "OK", function() end, function() end
                )
                return
            end

            if inLobby then
                queueTeleportLoad()
                getgenv().XvlamerHub_DailyRunActive = true
                lbl.TextColor3 = Color3.fromRGB(108, 92, 231)
                pcall(function()
                    local args = {
                        [1] = {
                            ["Mods"]        = {},
                            ["Settings"]    = {},
                            ["Destination"] = "Daily",
                            ["FriendsOnly"] = false,
                            ["MaxPlayers"]  = "1",
                        }
                    }
                    game:GetService("ReplicatedStorage")
                        :WaitForChild("RemotesFolder")
                        :WaitForChild("CreateElevator")
                        :FireServer(unpack(args))
                end)
            else
                getgenv().XvlamerHub_DailyRunActive = true
                lbl.TextColor3 = Color3.fromRGB(108, 92, 231)
            end

            -- Watch for completion and reset label color
            task.spawn(function()
                while getgenv().XvlamerHub_DailyRunActive do
                    task.wait(0.3)
                end
                pcall(function() lbl.TextColor3 = Color3.fromRGB(245, 245, 255) end)
            end)
        end, 0.5)
    end

    createToggle("Knob Farm",     pages[2], true,  false, 1)
    createToggle("Death Farm",    pages[2], true,  false, 2)
    createToggle("Stardust Farm", pages[2], true,  false, 3)
    createDailyRunButton(pages[2], 4)

    createToggle("Noclip",        pages[3], false, true,  1)
    createToggle("Noclip SPAM",   pages[3], false, true,  2)
    createToggle("Optimizations", pages[3], false, false, 3)
    createToggle("Anti-AFK",      pages[3], false, false, 4)

    local farmsLeftOn = {}
    for _, fname in ipairs({"Knob Farm", "Death Farm", "Stardust Farm"}) do
        if state.ToggleState[fname] == true then
            table.insert(farmsLeftOn, fname)
        end
    end

    task.spawn(function()
        task.wait(0.5)
        if getgenv().XvlamerHub_Cancelled then return end
        for _, tname in ipairs({"Noclip", "Noclip SPAM", "Optimizations", "Anti-AFK"}) do
            if state.ToggleState[tname] == true then
                local h = toggleHandlers[tname]
                if h and h.turnOnSilent then h.turnOnSilent() end
            end
        end
    end)

    if #farmsLeftOn > 0 then
        task.spawn(function()
            task.wait(0.8)
            if getgenv().XvlamerHub_Cancelled then return end
            for _, fname in ipairs(farmsLeftOn) do
                if getgenv().XvlamerHub_Cancelled then break end
                local h = toggleHandlers[fname]
                if not h then continue end

                local inLobby      = isInLobby()
                local currentFloor = getCurrentFloor()
                local isValidFloor = inLobby or currentFloor == "Hotel" or currentFloor == "Mines"
                if fname == "Stardust Farm" then
                    isValidFloor = inLobby or currentFloor == "Archives"
                end

                if not isValidFloor then h.setOff(); continue end

                if inLobby then
                    showPopupModal(
                        "XvlamersRestore_" .. fname:gsub(" ", ""),
                        "⚠️ " .. fname:upper() .. " WAS LEFT ON",
                        fname .. " was active when you left. Would you like to resume it?",
                        "Cancel", "Resume",
                        function() h.setOff() end,
                        function()
                            if not getgenv().XvlamerHub_Cancelled and h.turnOnSilent then h.turnOnSilent() end
                        end
                    )
                else
                    h.setOff()
                end

                task.wait(0.3)
                repeat task.wait(0.1) until getgenv().XvlamerHub_Cancelled or not isModalOpen()
            end
        end)
    end
end

local function startKeySystem()
    if getgenv().XvlamerHub_Cancelled then return end
    local keyGui = create("ScreenGui", {
        Name           = "XvlamersKeySystem",
        ResetOnSpawn   = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder   = 999,
        Parent         = safeUI,
    })
    pcall(function() if syn and syn.protect_gui then syn.protect_gui(keyGui) end end)

    local keyFrame = create("Frame", {
        Size               = UDim2.new(0, 320, 0, 145),
        Position           = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint        = Vector2.new(0.5, 0.5),
        BackgroundColor3   = Color3.fromRGB(11, 11, 15),
        BorderSizePixel    = 0,
        ClipsDescendants   = true,
        Parent             = keyGui,
    })
    create("UICorner", { CornerRadius = UDim.new(0, 14), Parent = keyFrame })
    create("UIStroke",  { Color = THEME_PURPLE, Transparency = 0.15, Thickness = 1.5, Parent = keyFrame })
    makeUniversalDraggable(keyFrame)

    _G.XvlamerHub_CloseKeySystem = function()
        pcall(function() keyGui:Destroy() end)
    end

    local closeKeyBtn = create("TextButton", {
        Size = UDim2.new(0, 24, 0, 24), Position = UDim2.new(1, -32, 0, 12),
        BackgroundColor3 = Color3.fromRGB(20, 20, 28),
        Font = Enum.Font.GothamBold, Text = "✕",
        TextColor3 = Color3.fromRGB(180, 180, 200), TextSize = 10, Parent = keyFrame,
    })
    create("UICorner", { CornerRadius = UDim.new(0, 7), Parent = closeKeyBtn })
    onDebouncedClick(closeKeyBtn, function() _G.XvlamerHub_CloseKeySystem() end, 0.2)

    create("TextLabel", {
        Size = UDim2.new(1, -40, 0, 12), Position = UDim2.new(0, 15, 0, 12),
        BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
        Text = "AUTHENTICATION", TextColor3 = THEME_PURPLE, TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = keyFrame,
    })
    create("TextLabel", {
        Size = UDim2.new(1, -40, 0, 16), Position = UDim2.new(0, 15, 0, 24),
        BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
        Text = "You must get the key from the script owner.",
        TextColor3 = Color3.fromRGB(245, 245, 255), TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = keyFrame,
    })

    local errorLbl = create("TextLabel", {
        Size = UDim2.new(1, -30, 0, 14), Position = UDim2.new(0, 15, 0, 42),
        BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
        Text = "", TextColor3 = Color3.fromRGB(255, 85, 85), TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = keyFrame,
    })

    local tbBg = create("Frame", {
        Size = UDim2.new(1, -30, 0, 32), Position = UDim2.new(0, 15, 0, 62),
        BackgroundColor3 = Color3.fromRGB(15, 15, 22), Parent = keyFrame,
    })
    create("UICorner", { CornerRadius = UDim.new(0, 9), Parent = tbBg })
    create("UIStroke",  { Color = Color3.fromRGB(45, 45, 60), Transparency = 0.2, Thickness = 1, Parent = tbBg })

    local keyInput = create("TextBox", {
        Size = UDim2.new(1, -16, 1, 0), Position = UDim2.new(0, 8, 0, 0),
        BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
        PlaceholderText = "Enter key here...", Text = "",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        PlaceholderColor3 = Color3.fromRGB(110, 110, 135),
        TextSize = 11, ClearTextOnFocus = true, Parent = tbBg,
    })

    local confirmBtn = create("TextButton", {
        Size = UDim2.new(1, -30, 0, 32), Position = UDim2.new(0, 15, 0, 102),
        BackgroundColor3 = THEME_PURPLE, Font = Enum.Font.GothamBold,
        Text = "Confirm", TextColor3 = Color3.fromRGB(255, 255, 255),
        TextSize = 11, AutoButtonColor = false, Parent = keyFrame,
    })
    create("UICorner", { CornerRadius = UDim.new(0, 9), Parent = confirmBtn })

    onDebouncedClick(confirmBtn, function()
        if keyInput.Text == CORRECT_KEY then
            state.KeyExpiry = os.time() + 86400
            pcall(saveState)
            _G.XvlamerHub_CloseKeySystem()
            initializeMainHub()
        else
            errorLbl.Text = "Incorrect key! Verify with the script owner."
        end
    end, 0.2)
end

local passedKey = select(1, ...)
local globalKey = getgenv().Key or _G.Key or getgenv().XvlamerKey

if  (passedKey == CORRECT_KEY)
 or (globalKey == CORRECT_KEY)
 or (state.KeyExpiry and os.time() < state.KeyExpiry)
then
    state.KeyExpiry = os.time() + 86400
    pcall(saveState)
    initializeMainHub()
else
    startKeySystem()
end
