        end

        local function closeModalAndRun(callback)
            if isClosingModal then return end
            isClosingModal = true
            activeCountdown = false
            pcall(function()
                for _, conn in ipairs(popupConns) do
                    if conn then pcall(function() conn:Disconnect() end) end
