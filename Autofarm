    mainRef = nil

    local function destroyOwned(parent)
        if not parent then return end
        for _, v in pairs(parent:GetChildren()) do
            if v.Name == guiName
                or v.Name == "XvlamersMobileToggle"
                or v.Name == "XvlamersKeySystem"
                or v.Name:match("^Xvlamers") then
                pcall(function() v:Destroy() end)
            end
        end
