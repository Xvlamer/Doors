local function onDebouncedClick(btn, callback, cooldown)
    cooldown = cooldown or 0
    local last = 0
    local function trigger()
        if getgenv().XvlamerHub_Cancelled then return end
        local now = tick()
        if now - last < cooldown then return end
        last = now
        pcall(callback)
    end
    trackConnection(btn.MouseButton1Click:Connect(trigger))
    if isMobile then
        pcall(function() trackConnection(btn.Activated:Connect(trigger)) end)
        pcall(function() trackConnection(btn.TouchTap:Connect(trigger)) end)
    end
end

local function isModalOpen()
