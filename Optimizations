local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local Terrain = Workspace:FindFirstChildOfClass("Terrain")

local entitySounds = {
    ["Footsteps"] = true,
    ["Kill"] = true,
    ["Knock"] = true,
    ["PlaySound"] = true,
    ["Repent"] = true,
    ["Scream"] = true,
    ["Sounds"] = true
}

local whitelistedKeywords = {
    -- Entities & Items
    "rush", "ambush", "hide", "seek", "figure", "screech", "eyes", "halt", "dupe",
    "timothy", "jack", "glitch", "void", "dread", "snare", "window", "shadow", "sally",
    "guiding light", "guidinglight", "el goblino", "jeff", "bob", "a-60", "a-90", "a-120",
    "curious light", "blitz", "lookman", "haste", "giggle", "grumble", "queen grumble",
    "gloombats", "louie", "bramble", "caws", "eyestalk", "grampy", "groundskeeper",
    "mandrake", "monument", "surge", "world lotus", "honcho", "ransom", "evil key",
    "greed", "jeff the killer", "subspace tripmine", "banana peel", "drakobloxxers",
    
    -- Rift, Center, StarCenter & Internal Components
    "riftspawn", "rift", "center", "starcenter", "riftprompt", "starriftprompt",
    "music", "musicclose", "soundmutate", "attachment", "itemholder",
    "particlesin", "particlesout"
}

local protectedCache = setmetatable({}, {__mode = "k"})

local function isPlayerCharacter(instance)
    if not instance then return false end
    local model = instance:IsA("Model") and instance or instance:FindFirstAncestorOfClass("Model")
    if model and Players:GetPlayerFromCharacter(model) then
        return true
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character and (instance == player.Character or instance:IsDescendantOf(player.Character)) then
            return true
        end
    end
    return false
end

local function matchesWhitelist(name)
    for _, keyword in ipairs(whitelistedKeywords) do
        if name:find(keyword) then
            return true
        end
    end
    return false
end

local function isProtected(instance)
    if not instance then return false end
    if isPlayerCharacter(instance) then return true end

    -- Robust traversal that handles StreamingEnabled safely
    local curr = instance
    while curr do
        if curr == game then break end
        if isPlayerCharacter(curr) then return true end
        if matchesWhitelist(curr.Name:lower()) then
            return true
        end
        curr = curr.Parent
    end

    local container = instance:FindFirstAncestorOfClass("Model") or instance:FindFirstAncestorOfClass("Folder") or (instance:IsA("Model") and instance) or (instance:IsA("Folder") and instance)
    if not container then return false end
    if isPlayerCharacter(container) then return true end
    if protectedCache[container] then return true end

    if matchesWhitelist(container.Name:lower()) then
        protectedCache[container] = true
        return true
    end

    for _, v in ipairs(container:GetDescendants()) do
        if isPlayerCharacter(v) then
            protectedCache[container] = true
            return true
        end
        if v:IsA("Sound") and entitySounds[v.Name] then
            protectedCache[container] = true
            return true
        end
        if matchesWhitelist(v.Name:lower()) then
            protectedCache[container] = true
            return true
        end
    end

    return false
end

local function applyOptimization(instance)
    pcall(function()
        if isProtected(instance) then return end

        if instance:IsA("BasePart") and not instance:IsA("Terrain") then
            instance.Material = Enum.Material.SmoothPlastic
            pcall(function() instance.MaterialVariant = "" end)
            instance.CastShadow = false
            if instance:IsA("MeshPart") then
                instance.TextureID = ""
            end
        elseif instance:IsA("SpecialMesh") then
            instance.TextureId = ""
        elseif instance:IsA("Decal") or instance:IsA("Texture") or instance:IsA("SurfaceAppearance") 
            or instance:IsA("ParticleEmitter") or instance:IsA("Fire") or instance:IsA("Smoke") 
            or instance:IsA("Sparkles") or instance:IsA("Trail") or instance:IsA("Beam") then
            instance:Destroy()
        end
    end)
end

pcall(function()
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9
    Lighting.FogStart = 9e9
    Lighting.Brightness = 2
    Lighting.ClockTime = 14
    Lighting.Ambient = Color3.fromRGB(130, 130, 130)
    Lighting.OutdoorAmbient = Color3.fromRGB(130, 130, 130)
    
    for _, v in ipairs(Lighting:GetDescendants()) do
        if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
            v.Enabled = false
        end
    end
end)

pcall(function()
    if Terrain then
        Terrain.WaterWaveSize = 0
        Terrain.WaterWaveSpeed = 0
        Terrain.WaterReflectance = 0
        Terrain.WaterTransparency = 1
        Terrain.Decoration = false
    end
end)

for _, v in ipairs(Workspace:GetDescendants()) do
    applyOptimization(v)
end

Workspace.DescendantAdded:Connect(function(instance)
    task.defer(applyOptimization, instance)
end)
