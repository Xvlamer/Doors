local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Terrain = Workspace:FindFirstChildOfClass("Terrain")

if getgenv().Xvlamer_OptActive == nil then
    getgenv().Xvlamer_OptActive = false
end

local entitySounds = {
    ["Footsteps"] = true,
    ["Kill"] = true,
    ["Knock"] = true,
    ["PlaySound"] = true,
    ["Repent"] = true,
    ["Scream"] = true,
    ["Sounds"] = true
}

local protectedCache = setmetatable({}, {__mode = "k"})

local function isProtected(instance)
    if not instance then return false end

    local name = instance.Name:lower()
    if name:find("guiding light") or name:find("guidinglight") or name:find("rift") then
        return true
    end

    -- Whitelist all particle emitters, trails, and beams so their textures and effects are never deleted
    if instance:IsA("ParticleEmitter") or instance:IsA("Trail") or instance:IsA("Beam") or instance:IsA("Fire") or instance:IsA("Smoke") or instance:IsA("Sparkles") then
        return true
    end

    local curr = instance
    while curr and curr ~= game do
        local cName = curr.Name:lower()
        if cName:find("guiding light") or cName:find("guidinglight") or cName:find("rift") then
            return true
        end
        curr = curr.Parent
    end

    local container = instance:FindFirstAncestorOfClass("Model") or instance:FindFirstAncestorOfClass("Folder") or (instance:IsA("Model") and instance) or (instance:IsA("Folder") and instance)
    if not container then return false end
    if protectedCache[container] then return true end

    local contName = container.Name:lower()
    if contName:find("guiding light") or contName:find("guidinglight") or contName:find("rift") then
        protectedCache[container] = true
        return true
    end

    for _, v in ipairs(container:GetDescendants()) do
        if v:IsA("Sound") and entitySounds[v.Name] then
            protectedCache[container] = true
            return true
        end
        local vName = v.Name:lower()
        if vName:find("guiding light") or vName:find("guidinglight") or vName:find("rift") then
            protectedCache[container] = true
            return true
        end
        if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then
            protectedCache[container] = true
            return true
        end
    end

    return false
end

local function applyOptimization(instance)
    pcall(function()
        if isProtected(instance) then return end

        if instance:IsA("BasePart") and not instance:IsA("Terrain") then
            instance.Material = Enum.Material.SmoothPlastic
            pcall(function() instance.MaterialVariant = "" end)
            instance.CastShadow = false
            if instance:IsA("MeshPart") then
                instance.TextureID = ""
            end
        elseif instance:IsA("SpecialMesh") then
            instance.TextureId = ""
        elseif instance:IsA("Decal") or instance:IsA("Texture") or instance:IsA("SurfaceAppearance") then
            instance:Destroy()
        end
    end)
end

local function setOptimizations(state)
    if state == nil then
        getgenv().Xvlamer_OptActive = not getgenv().Xvlamer_OptActive
    else
        getgenv().Xvlamer_OptActive = state and true or false
    end

    if getgenv().Xvlamer_OptConn then
        getgenv().Xvlamer_OptConn:Disconnect()
        getgenv().Xvlamer_OptConn = nil
    end

    if not getgenv().Xvlamer_OptActive then
        return
    end

    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.FogStart = 9e9
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.Ambient = Color3.fromRGB(130, 130, 130)
        Lighting.OutdoorAmbient = Color3.fromRGB(130, 130, 130)
        
        for _, v in ipairs(Lighting:GetDescendants()) do
            if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
                v.Enabled = false
            end
        end
    end)

    pcall(function()
        if Terrain then
            Terrain.WaterWaveSize = 0
            Terrain.WaterWaveSpeed = 0
            Terrain.WaterReflectance = 0
            Terrain.WaterTransparency = 1
            Terrain.Decoration = false
        end
    end)

    for _, v in ipairs(Workspace:GetDescendants()) do
        applyOptimization(v)
    end

    getgenv().Xvlamer_OptConn = Workspace.DescendantAdded:Connect(function(instance)
        if getgenv().Xvlamer_OptActive then
            task.defer(applyOptimization, instance)
        end
    end)
end

getgenv().Xvlamer_SetOptimizations = setOptimizations
return setOptimizations
