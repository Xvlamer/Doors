local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Terrain = Workspace:FindFirstChildOfClass("Terrain")

local entitySounds = {
    ["Footsteps"] = true,
    ["Kill"] = true,
    ["Knock"] = true,
    ["PlaySound"] = true,
    ["Repent"] = true,
    ["Scream"] = true,
    ["Sounds"] = true
}

local blacklistedKeywords = {
    "rush", "ambush", "hide", "seek", "figure", "screech", "eyes", "halt", "dupe",
    "timothy", "jack", "glitch", "void", "dread", "snare", "window", "shadow", "sally",
    "guiding light", "guidinglight", "el goblino", "jeff", "bob", "a-60", "a-90", "a-120",
    "curious light", "blitz", "lookman", "haste", "giggle", "grumble", "queen grumble",
    "gloombats", "louie", "bramble", "caws", "eyestalk", "grampy", "groundskeeper",
    "mandrake", "monument", "surge", "world lotus", "honcho", "ransom", "evil key",
    "greed", "jeff the killer", "subspace tripmine", "banana peel", "drakobloxxers",
    "riftspawn", "rift", "center", "starcenter", "riftprompt", "starriftprompt",
    "music", "musicclose", "soundmutate", "attachment", "itemholder",
    "particlesin", "particlesout"
}

-- Normalize all keywords to lowercase automatically to prevent capitalization bugs
for i, keyword in ipairs(blacklistedKeywords) do
    blacklistedKeywords[i] = keyword:lower()
end

local function isPlayerCharacter(instance)
    if not instance then return false end
    local model = instance:IsA("Model") and instance or instance:FindFirstAncestorOfClass("Model")
    if model and Players:GetPlayerFromCharacter(model) then
        return true
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character and (instance == player.Character or instance:IsDescendantOf(player.Character)) then
            return true
        end
    end
    return false
end

local function isProtected(instance)
    if not instance then return false end
    if isPlayerCharacter(instance) then return true end

    -- Check instance and all parents/ancestors case-insensitively
    local curr = instance
    while curr and curr ~= game do
        local success, name = pcall(function() return curr.Name end)
        if success and name then
            local nameLower = name:lower()
            for _, keyword in ipairs(blacklistedKeywords) do
                if nameLower:find(keyword, 1, true) then
                    return true
                end
            end
        end
        curr = curr.Parent
    end

    -- Check container and descendants safely without broken caching
    local container = instance:IsA("Model") and instance or instance:IsA("Folder") and instance or instance:FindFirstAncestorOfClass("Model") or instance:FindFirstAncestorOfClass("Folder")
    if container then
        if isPlayerCharacter(container) then return true end

        local successC, cName = pcall(function() return container.Name end)
        if successC and cName then
            local cNameLower = cName:lower()
            for _, keyword in ipairs(blacklistedKeywords) do
                if cNameLower:find(keyword, 1, true) then
                    return true
                end
            end
        end

        local successDesc, descendants = pcall(function() return container:GetDescendants() end)
        if successDesc and descendants then
            for _, v in ipairs(descendants) do
                if isPlayerCharacter(v) or (v:IsA("Sound") and entitySounds[v.Name]) then
                    return true
                end
                local successV, vName = pcall(function() return v.Name end)
                if successV and vName then
                    local vNameLower = vName:lower()
                    for _, keyword in ipairs(blacklistedKeywords) do
                        if vNameLower:find(keyword, 1, true) then
                            return true
                        end
                    end
                end
            end
        end
    end

    return false
end

local function applyOptimization(instance)
    pcall(function()
        if isProtected(instance) then return end

        if instance:IsA("BasePart") and not instance:IsA("Terrain") then
            instance.Material = Enum.Material.SmoothPlastic
            pcall(function() instance.MaterialVariant = "" end)
            instance.CastShadow = false
            if instance:IsA("MeshPart") then
                instance.TextureID = ""
            end
        elseif instance:IsA("SpecialMesh") then
            instance.TextureId = ""
        elseif instance:IsA("Decal") or instance:IsA("Texture") or instance:IsA("SurfaceAppearance") 
            or instance:IsA("ParticleEmitter") or instance:IsA("Fire") or instance:IsA("Smoke") 
            or instance:IsA("Sparkles") or instance:IsA("Trail") or instance:IsA("Beam") then
            instance:Destroy()
        end
    end)
end

local function enforceLightingAndFog()
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.ShadowSoftness = 0
        Lighting.Brightness = 3
        Lighting.ClockTime = 14
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        Lighting.FogEnd = 9e9
        Lighting.FogStart = 9e9
        Lighting.FogColor = Color3.fromRGB(255, 255, 255)
        
        for _, v in ipairs(Lighting:GetDescendants()) do
            if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") or v:IsA("Fog") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") then
                v:Destroy()
            end
        end
    end)

    pcall(function()
        if Terrain then
            Terrain.WaterWaveSize = 0
            Terrain.WaterWaveSpeed = 0
            Terrain.WaterReflectance = 0
            Terrain.WaterTransparency = 1
            Terrain.Decoration = false
        end
    end)
end

RunService.RenderStepped:Connect(function()
    enforceLightingAndFog()
end)

for _, v in ipairs(Workspace:GetDescendants()) do
    applyOptimization(v)
end

Workspace.DescendantAdded:Connect(function(instance)
    task.defer(applyOptimization, instance)
end)
